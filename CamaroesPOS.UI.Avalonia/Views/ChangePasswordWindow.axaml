<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CamaroesPOS.UI.Avalonia.Views.ChangePasswordWindow"
        Title="{DynamicResource Str_ChangerdeMotdeP_d8c6}"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FE">
    <Border Classes="Card" Margin="18" Padding="24">
        <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource Str_ChangerMotdePas_c46b}" Classes="CardTitle"/>

            <TextBlock Text="{DynamicResource Str_Ancienmotdepass_6082}" Classes="LabelMuted"/>
            <TextBox x:Name="TxtOldPassword" PasswordChar="•"/>

            <TextBlock Text="{DynamicResource Str_Nouveaumotdepas_d383}" Classes="LabelMuted"/>
            <TextBox x:Name="TxtNewPassword" PasswordChar="•"/>

            <TextBlock Text="{DynamicResource Str_Confirmerlenouv_1c8c}" Classes="LabelMuted"/>
            <TextBox x:Name="TxtConfirmPassword" PasswordChar="•"/>

            <TextBlock x:Name="TxtError" Foreground="#E53935" FontSize="12" TextWrapping="Wrap" IsVisible="False"/>

            <UniformGrid Columns="2" Margin="0,10,0,0">
                <Button Classes="Outlined" Content="{DynamicResource Str_ANNULER_1ce3}" Margin="0,0,6,0" Click="BtnCancel_Click"/>
                <Button Classes="Primary" Content="{DynamicResource Str_ENREGISTRER_6d15}" Margin="6,0,0,0" Click="BtnSave_Click"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
