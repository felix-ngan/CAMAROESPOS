<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CamaroesPOS.UI.Avalonia.Views.MessageDialogWindow"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Border Padding="24" Background="White">
        <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <materialIcons:MaterialIcon x:Name="IconGlyph" Kind="InformationOutline" Width="28" Height="28" Foreground="#1E88E5" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitle" Text="Information" FontSize="18" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="TxtMessage" Text="" TextWrapping="Wrap" FontSize="14" Foreground="#4A5568" LineHeight="20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                <Button x:Name="BtnNo" Content="Non" IsVisible="False" Classes="Outlined" Padding="18,8" Click="BtnNo_Click"/>
                <Button x:Name="BtnYes" Content="OK" Classes="Primary" Padding="22,8" Click="BtnYes_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
