<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CamaroesPOS.UI.Avalonia.Views.ReceiptWindow"
        Title="{DynamicResource Str_ReudeCaisse_62fa}"
        Width="440" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FE">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Border Classes="Card" Background="White" Padding="24">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource Str_CAMAROES_f245}" FontSize="24" FontWeight="ExtraBlack" HorizontalAlignment="Center" Foreground="#2B3674"/>
                    <TextBlock Text="{DynamicResource Str_VotrePartenaire_7c9f}" FontSize="12" HorizontalAlignment="Center" Foreground="#8F9BBA"/>
                    <TextBlock Text="{DynamicResource Str_DoualaCameroun_c28d}" FontSize="11" HorizontalAlignment="Center" Foreground="#8F9BBA"/>
                    <TextBlock Text="{DynamicResource Str_Tl237600000000_2edf}" FontSize="11" HorizontalAlignment="Center" Foreground="#8F9BBA"/>

                    <Border Height="1" Background="#E0E5F2" Margin="0,6"/>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_ReuN_b54d}" FontSize="12" Foreground="#4A5568" Margin="0,0,8,4"/>
                        <TextBlock x:Name="TxtTransNo" Grid.Row="0" Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="#2B3674" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_Date_a16b}" FontSize="12" Foreground="#4A5568" Margin="0,0,8,4"/>
                        <TextBlock x:Name="TxtDate" Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="#2B3674" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_Modedepaiement_994f}" FontSize="12" Foreground="#4A5568" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtPaymentMode" Grid.Row="2" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#1E88E5" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="#E0E5F2" Margin="0,6"/>

                    <Grid ColumnDefinitions="*,50,90">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_Article_5e2f}" FontWeight="Bold" FontSize="12" Foreground="#2B3674"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str_Qt_493a}" FontWeight="Bold" FontSize="12" Foreground="#2B3674" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Str_Total_96b0}" FontWeight="Bold" FontSize="12" Foreground="#2B3674" HorizontalAlignment="Right"/>
                    </Grid>

                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,50,90" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding ProductDescription}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Qty}" FontSize="12" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat='{}{0:N0}'}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="#E0E5F2" Margin="0,8"/>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Soustotal_f804}" FontSize="13" Foreground="#4A5568" Margin="0,2"/>
                        <TextBlock x:Name="TxtSubTotal" Grid.Row="0" Grid.Column="1" FontSize="13" HorizontalAlignment="Right" Margin="0,2"/>

                        <TextBlock x:Name="LblDiscount" Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_Rduction_1fbd}" FontSize="13" Foreground="#FB8C00" Margin="0,2"/>
                        <TextBlock x:Name="TxtDiscount" Grid.Row="1" Grid.Column="1" FontSize="13" Foreground="#FB8C00" HorizontalAlignment="Right" Margin="0,2"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_TOTALPAYER_6722}" FontSize="15" FontWeight="Bold" Foreground="#2B3674" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtTotal" Grid.Row="2" Grid.Column="1" FontSize="15" FontWeight="Bold" Foreground="#1E88E5" HorizontalAlignment="Right" Margin="0,6,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str_MontantReu_2e3b}" FontSize="13" Foreground="#4A5568" Margin="0,2"/>
                        <TextBlock x:Name="TxtReceived" Grid.Row="3" Grid.Column="1" FontSize="13" HorizontalAlignment="Right" Margin="0,2"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Str_MonnaieRendue_8852}" FontSize="13" Foreground="#2E7D32" FontWeight="SemiBold" Margin="0,2"/>
                        <TextBlock x:Name="TxtChange" Grid.Row="4" Grid.Column="1" FontSize="13" Foreground="#2E7D32" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2"/>
                    </Grid>

                    <Border Height="1" Background="#E0E5F2" Margin="0,8"/>
                    <TextBlock Text="{DynamicResource Str_Mercidevotrevis_4a05}" FontStyle="Italic" FontSize="13" HorizontalAlignment="Center" Foreground="#2B3674"/>
                    <TextBlock Text="{DynamicResource Str_Lesarticlesvend_ba7a}" FontSize="11" HorizontalAlignment="Center" Foreground="#8F9BBA" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,12,0,0">
            <Button Classes="Primary" Margin="0,0,6,0" Click="BtnExportPdf_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="FilePdfBox" Width="18" Height="18"/>
                    <TextBlock Text="{DynamicResource Str_ExporterPDF_94c4}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Classes="Outlined" Margin="3,0" Click="BtnPrint_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="Printer" Width="18" Height="18"/>
                    <TextBlock Text="{DynamicResource Str_Imprimer_9430}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Classes="DangerOutlined" Margin="6,0,0,0" Content="{DynamicResource Str_Fermer_7d20}" Click="BtnClose_Click"/>
        </UniformGrid>
    </Grid>
</Window>
