<Window x:Class="CamaroesPOS.UI.Views.BrandCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
        Title="Gestion des Marques et Catégories" Height="500" Width="800" WindowStartupLocation="CenterScreen" Background="#F4F7FE">
    
    <Window.DataContext>
        <viewmodels:BrandCategoryViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditingBrand}" Value="True">
                    <Setter Property="Content" Value="ENREGISTRER" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditingBrand}" Value="False">
                    <Setter Property="Content" Value="AJOUTER" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SaveCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditingCategory}" Value="True">
                    <Setter Property="Content" Value="ENREGISTRER" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditingCategory}" Value="False">
                    <Setter Property="Content" Value="AJOUTER" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Marques -->
        <materialDesign:Card Grid.Column="0" Padding="15" UniformCornerRadius="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="MARQUES" FontSize="18" FontWeight="Bold" Foreground="#2B3674" Margin="0,0,0,15" />
                
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Nouvelle Marque" Text="{Binding NewBrandName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                    <Button Grid.Column="1" Command="{Binding CancelEditBrandCommand}" Content="ANNULER" Margin="10,0,0,0" Style="{StaticResource MaterialDesignOutlinedButton}" Visibility="{Binding IsEditingBrand, Converter={StaticResource BoolToVis}}" Foreground="Gray" BorderBrush="Gray" />
                    <Button Grid.Column="2" Command="{Binding SaveBrandCommand}" Margin="10,0,0,0" Style="{StaticResource SaveButtonStyle}" />
                </Grid>
                
                <DataGrid Grid.Row="2" ItemsSource="{Binding Brands}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom de la Marque" Binding="{Binding BrandName}" Width="*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Action" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.EditBrandCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#1E88E5" Height="25" Width="25" ToolTip="Modifier">
                                            <materialDesign:PackIcon Kind="Pencil" />
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.DeleteBrandCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#E53935" Height="25" Width="25" ToolTip="Supprimer">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- Catégories -->
        <materialDesign:Card Grid.Column="2" Padding="15" UniformCornerRadius="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="CATÉGORIES" FontSize="18" FontWeight="Bold" Foreground="#2B3674" Margin="0,0,0,15" />
                
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Nouvelle Catégorie" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                    <Button Grid.Column="1" Command="{Binding CancelEditCategoryCommand}" Content="ANNULER" Margin="10,0,0,0" Style="{StaticResource MaterialDesignOutlinedButton}" Visibility="{Binding IsEditingCategory, Converter={StaticResource BoolToVis}}" Foreground="Gray" BorderBrush="Gray" />
                    <Button Grid.Column="2" Command="{Binding SaveCategoryCommand}" Margin="10,0,0,0" Style="{StaticResource SaveCategoryButtonStyle}" />
                </Grid>
                
                <DataGrid Grid.Row="2" ItemsSource="{Binding Categories}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom de la Catégorie" Binding="{Binding CategoryName}" Width="*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Action" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#1E88E5" Height="25" Width="25" ToolTip="Modifier">
                                            <materialDesign:PackIcon Kind="Pencil" />
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#E53935" Height="25" Width="25" ToolTip="Supprimer">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
