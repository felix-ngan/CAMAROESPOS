<Window x:Class="CamaroesPOS.UI.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Str_ChangerdeMotdeP_d8c6}" Height="400" Width="400"
        WindowStartupLocation="CenterOwner" 
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="KeyVariant" Width="30" Height="30" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="{DynamicResource Str_ChangerMotdePas_c46b}" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Ancien Mot de passe -->
            <PasswordBox x:Name="TxtOldPassword" materialDesign:HintAssist.Hint="{DynamicResource Str_Ancienmotdepass_6082}" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,20" FontSize="16" />
            
            <!-- Nouveau Mot de passe -->
            <PasswordBox x:Name="TxtNewPassword" materialDesign:HintAssist.Hint="{DynamicResource Str_Nouveaumotdepas_d383}" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,20" FontSize="16" />
            
            <!-- Confirmer Mot de passe -->
            <PasswordBox x:Name="TxtConfirmPassword" materialDesign:HintAssist.Hint="{DynamicResource Str_Confirmerlenouv_1c8c}" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,20" FontSize="16" />
            
            <TextBlock x:Name="TxtError" Foreground="#E53935" Visibility="Collapsed" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource Str_ANNULER_1ce3}" Click="BtnCancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Foreground="Gray" BorderBrush="Gray" Height="40" />
            <Button Grid.Column="1" Content="{DynamicResource Str_VALIDER_aedd}" Click="BtnSave_Click" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5,0,0,0" Background="#1E88E5" BorderBrush="#1E88E5" Height="40" />
        </Grid>
    </Grid>
</Window>
