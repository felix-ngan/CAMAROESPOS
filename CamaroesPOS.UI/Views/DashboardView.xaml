<UserControl x:Class="CamaroesPOS.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
             Background="{DynamicResource MaterialDesignPaper}">
    <UserControl.DataContext>
        <viewmodels:DashboardViewModel />
    </UserControl.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Button Grid.Row="0" HorizontalAlignment="Right" Margin="10" 
                Style="{StaticResource MaterialDesignOutlinedButton}" 
                Content="Rafraîchir" Click="BtnRefresh_Click"/>
        
        <UniformGrid Grid.Row="1" Columns="4" Margin="10">
            <!-- Ventes du jour -->
            <materialDesign:Card Margin="10" Padding="20" Background="#1E88E5" Foreground="White">
                <StackPanel>
                    <materialDesign:PackIcon Kind="CashRegister" Width="48" Height="48" />
                    <TextBlock Text="Ventes Aujourd'hui" FontSize="16" Margin="0,10,0,0" Opacity="0.8" />
                    <TextBlock Text="{Binding TodaySales, StringFormat={}{0:N0} FCFA}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:Card>
            
            <!-- Nombre de produits -->
            <materialDesign:Card Margin="10" Padding="20" Background="#43A047" Foreground="White">
                <StackPanel>
                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="48" Height="48" />
                    <TextBlock Text="Total Articles" FontSize="16" Margin="0,10,0,0" Opacity="0.8" />
                    <TextBlock Text="{Binding TotalProducts}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Alertes Stock -->
            <materialDesign:Card Margin="10" Padding="20" Background="#E53935" Foreground="White">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AlertDecagram" Width="48" Height="48" />
                    <TextBlock Text="Rupture de Stock" FontSize="16" Margin="0,10,0,0" Opacity="0.8" />
                    <TextBlock Text="{Binding LowStockItems}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Solde Portefeuilles -->
            <materialDesign:Card Margin="10" Padding="20" Background="#8E24AA" Foreground="White">
                <StackPanel>
                    <materialDesign:PackIcon Kind="Wallet" Width="48" Height="48" />
                    <TextBlock Text="Fonds Portefeuilles" FontSize="16" Margin="0,10,0,0" Opacity="0.8" />
                    <TextBlock Text="{Binding TotalWalletsBalance, StringFormat={}{0:N0} FCFA}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>
    </Grid>
</UserControl>
