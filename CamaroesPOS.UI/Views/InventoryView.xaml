<UserControl x:Class="CamaroesPOS.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
             Background="Transparent">
    <UserControl.DataContext>
        <viewmodels:InventoryViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource Str_GestiondesStock_2931}" FontSize="28" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center" />
            
            <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="{DynamicResource Str_Rechercherunpro_97e5}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="20,0,20,0" FontSize="16" Style="{StaticResource MaterialDesignFloatingHintTextBox}" MaxWidth="400" HorizontalAlignment="Right" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <Button Content="{DynamicResource Str_MARQUESCATGORIE_7ed4}" Command="{Binding ManageCatalogCommand}" Margin="0,0,10,0" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#3F51B5" BorderBrush="#3F51B5" />
                <Button Content="{DynamicResource Str_AJOUTERPRODUIT_d603}" Command="{Binding AddCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4318FF" Foreground="White" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- Main DataGrid -->
            <materialDesign:Card Grid.Column="0" Padding="15" UniformCornerRadius="15" Margin="0,0,20,0" Background="White">
                <DataGrid ItemsSource="{Binding InventoryList}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Str_Code_ca0d}" Binding="{Binding ProductCode}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource Str_Description_b5a7}" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource Str_Prix_bc13}" Binding="{Binding Price, StringFormat={}{0:N0} FCFA}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource Str_Stock_27ce}" Binding="{Binding Qty}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource Str_Fournisseur_73d1}" Binding="{Binding VendorName}" Width="*" IsReadOnly="True" />
                        
                        <DataGridTemplateColumn Header="{DynamicResource Str_Actions_06df}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.AdjustStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Ajuster le stock" Height="30" Width="30" Foreground="#43A047">
                                            <materialDesign:PackIcon Kind="SwapVertical" />
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Éditer le produit" Height="30" Width="30" Foreground="#1E88E5">
                                            <materialDesign:PackIcon Kind="Pencil" />
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Supprimer le produit" Height="30" Width="30" Foreground="#E53935">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Right Edit Panel -->
            <materialDesign:Card Grid.Column="1" Padding="20" UniformCornerRadius="15" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_FicheProduit_7823}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2B3674" />
                        
                        <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_CodeProduit_ba21}" Text="{Binding SelectedProduct.ProductCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_Description_b5a7}" Text="{Binding SelectedProduct.Description}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_Prix_bc13}" Text="{Binding SelectedProduct.Price}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_Quantit_1b27}" Text="{Binding SelectedProduct.Qty}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_NiveaudAlerteSt_feda}" Text="{Binding SelectedProduct.Reorder}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_CodeBarre_840b}" Text="{Binding SelectedProduct.Barcode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        
                        <ComboBox materialDesign:HintAssist.Hint="{DynamicResource Str_Marque_a3e2}" ItemsSource="{Binding Brands}" DisplayMemberPath="BrandName" SelectedValuePath="BrandName" SelectedValue="{Binding SelectedProduct.BrandName}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,15" />
                        <ComboBox materialDesign:HintAssist.Hint="{DynamicResource Str_Catgorie_8c6b}" ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryName" SelectedValue="{Binding SelectedProduct.CategoryName}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,15" />
                        <ComboBox materialDesign:HintAssist.Hint="{DynamicResource Str_Fournisseur_73d1}" ItemsSource="{Binding Vendors}" DisplayMemberPath="VendorName" SelectedValuePath="Id" SelectedValue="{Binding SelectedProduct.VendorId}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,30" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{DynamicResource Str_ANNULER_1ce3}" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Foreground="Gray" BorderBrush="Gray" />
                            <Button Grid.Column="1" Content="{DynamicResource Str_ENREGISTRER_6d15}" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
            <!-- Right Adjust Stock Panel -->
            <materialDesign:Card Grid.Column="1" Padding="20" UniformCornerRadius="15" Visibility="{Binding IsAdjustingStock, Converter={StaticResource BoolToVis}}" Background="White">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_AjustementdeSto_c3ff}" FontSize="20" FontWeight="Bold" Margin="0,0,0,5" Foreground="#2B3674" />
                    <TextBlock Text="{Binding SelectedProduct.Description}" FontSize="16" Foreground="Gray" Margin="0,0,0,20" />
                    
                    <ComboBox materialDesign:HintAssist.Hint="{DynamicResource Str_TypedOpration_e475}" ItemsSource="{Binding AdjustmentTypes}" SelectedItem="{Binding AdjustmentType}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,15" />
                    
                    <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_Quantit_1b27}" Text="{Binding AdjustmentQuantity}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                    
                    <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_JustificationMo_f5c0}" Text="{Binding AdjustmentJustification}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="80" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,30" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource Str_ANNULER_1ce3}" Command="{Binding CancelAdjustmentCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Foreground="Gray" BorderBrush="Gray" />
                        <Button Grid.Column="1" Content="{DynamicResource Str_VALIDER_aedd}" Command="{Binding SaveAdjustmentCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5,0,0,0" Background="#43A047" BorderBrush="#43A047" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
