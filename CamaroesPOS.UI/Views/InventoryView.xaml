<UserControl x:Class="CamaroesPOS.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
             Background="Transparent">
    <UserControl.DataContext>
        <viewmodels:InventoryViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="PackageVariant" Width="30" Height="30" VerticalAlignment="Center" Foreground="#1E88E5"/>
            <TextBlock Text="Gestion des Stocks" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#2B3674" />
            
            <Button Content="NOUVEAU PRODUIT" Command="{Binding AddCommand}" Margin="30,0,0,0" Style="{StaticResource MaterialDesignRaisedButton}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- Main DataGrid -->
            <materialDesign:Card Grid.Column="0" Padding="15" UniformCornerRadius="15" Margin="0,0,20,0" Background="White">
                <DataGrid ItemsSource="{Binding InventoryList}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Prix" Binding="{Binding Price, StringFormat={}{0:N0} FCFA}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding Qty}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="Fournisseur" Binding="{Binding VendorName}" Width="*" IsReadOnly="True" />
                        
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Éditer le produit" Height="30" Width="30" Foreground="#1E88E5">
                                            <materialDesign:PackIcon Kind="Pencil" />
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Supprimer le produit" Height="30" Width="30" Foreground="#E53935">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Right Edit Panel -->
            <materialDesign:Card Grid.Column="1" Padding="20" UniformCornerRadius="15" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Fiche Produit" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2B3674" />
                        
                        <TextBox materialDesign:HintAssist.Hint="Code Produit" Text="{Binding SelectedProduct.ProductCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="Description" Text="{Binding SelectedProduct.Description}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="Prix" Text="{Binding SelectedProduct.Price}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="Quantité" Text="{Binding SelectedProduct.Qty}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="Niveau d'Alerte Stock" Text="{Binding SelectedProduct.Reorder}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="Code Barre" Text="{Binding SelectedProduct.Barcode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="Marque" Text="{Binding SelectedProduct.BrandName}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <TextBox materialDesign:HintAssist.Hint="Catégorie" Text="{Binding SelectedProduct.CategoryName}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
                        <ComboBox materialDesign:HintAssist.Hint="Fournisseur" ItemsSource="{Binding Vendors}" DisplayMemberPath="VendorName" SelectedValuePath="Id" SelectedValue="{Binding SelectedProduct.VendorId}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,30" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="ANNULER" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Foreground="Gray" BorderBrush="Gray" />
                            <Button Grid.Column="1" Content="ENREGISTRER" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
