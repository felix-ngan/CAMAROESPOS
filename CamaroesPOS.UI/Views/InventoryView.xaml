<UserControl x:Class="CamaroesPOS.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
             Background="{DynamicResource MaterialDesignPaper}">
    <UserControl.DataContext>
        <viewmodels:InventoryViewModel />
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="PackageVariant" Width="30" Height="30" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Gestion des Stocks" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            
            <Button Content="NOUVEAU PRODUIT" Margin="30,0,0,0" Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>

        <materialDesign:Card Grid.Row="1" Padding="15" UniformCornerRadius="10">
            <DataGrid ItemsSource="{Binding InventoryList}" AutoGenerateColumns="False" CanUserAddRows="False" AlternatingRowBackground="#F5F5F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code Produit" Binding="{Binding ProductCode}" Width="150" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Prix" Binding="{Binding Price, StringFormat={}{0:C}}" Width="150" />
                    <DataGridTextColumn Header="Quantité en Stock" Binding="{Binding Qty}" Width="150" />
                    
                    <DataGridTemplateColumn Header="Actions" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Éditer le stock" Height="30" Width="30">
                                    <materialDesign:PackIcon Kind="Pencil" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
