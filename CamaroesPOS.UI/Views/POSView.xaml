<UserControl x:Class="CamaroesPOS.UI.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
             Background="{DynamicResource MaterialDesignPaper}">
    <UserControl.DataContext>
        <viewmodels:POSViewModel />
    </UserControl.DataContext>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Catalogue Produits -->
        <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="10" Background="White" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Catalogue Produits" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />
                
                <ListBox Grid.Row="1" ItemsSource="{Binding Products}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="5" Padding="10" Width="180">
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" Foreground="Green" Margin="0,5,0,0" />
                                    <Button Content="Ajouter" Margin="0,10,0,0" Style="{StaticResource MaterialDesignOutlinedButton}" />
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>
        </Border>

        <!-- Panier (Cart) -->
        <Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource PrimaryHueLightBrush}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Panier Actuel" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding Cart}" AutoGenerateColumns="False" Background="White" Opacity="0.9" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Article" Binding="{Binding ProductDescription}" Width="*" />
                        <DataGridTextColumn Header="Qté" Binding="{Binding Qty}" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" />
                    </DataGrid.Columns>
                </DataGrid>
                
                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <TextBlock Text="Total à Payer :" Foreground="White" FontSize="16" />
                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:C}}" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" />
                    <Button Content="ENCAISSER" Margin="0,15,0,0" Height="50" FontSize="18" Style="{StaticResource MaterialDesignRaisedDarkButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
