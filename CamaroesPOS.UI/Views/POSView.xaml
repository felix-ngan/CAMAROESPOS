<UserControl x:Class="CamaroesPOS.UI.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
             Background="{DynamicResource MaterialDesignPaper}">
    <UserControl.DataContext>
        <viewmodels:POSViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <materialDesign:DialogHost IsOpen="{Binding IsAnyDialogOpen}" CloseOnClickAway="False">
        <materialDesign:DialogHost.DialogContent>
            <Grid>
                <!-- CALCULATOR NUMPAD MODERNE -->
                <StackPanel Margin="20" Width="400" Visibility="{Binding IsCheckoutDialogOpen, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Règlement Espèces" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock Text="{Binding TotalAmount, StringFormat=Total à payer: {0:N0} FCFA}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" />

                    <!-- Champ de Saisie Editable -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding ReceivedAmountString, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Montant donné (FCFA)" FontSize="32" FontWeight="Bold" TextAlignment="Right" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="C" Command="{Binding ClearNumpadCommand}" FontSize="20" Foreground="Red" BorderBrush="Red" Style="{StaticResource MaterialDesignOutlinedButton}" Height="55" Width="55" />
                    </Grid>

                    <TextBlock Text="{Binding ChangeAmount, StringFormat=Reste à rendre: {0:N0} FCFA}" FontSize="26" FontWeight="Bold" Foreground="#E53935" HorizontalAlignment="Center" Margin="0,0,0,20" />

                    <!-- Boutons Rapides (Billets / Compte Exact) -->
                    <UniformGrid Columns="4" Rows="1" Margin="0,0,0,20">
                        <Button Content="Exact" Command="{Binding ExactAmountCommand}" Margin="2" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#1E88E5" BorderBrush="#1E88E5" />
                        <Button Content="5 000" Command="{Binding QuickCashCommand}" CommandParameter="5000" Margin="2" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#43A047" BorderBrush="#43A047" />
                        <Button Content="10 000" Command="{Binding QuickCashCommand}" CommandParameter="10000" Margin="2" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#43A047" BorderBrush="#43A047" />
                        <Button Content="20 000" Command="{Binding QuickCashCommand}" CommandParameter="20000" Margin="2" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#43A047" BorderBrush="#43A047" />
                    </UniformGrid>

                    <!-- Pavé Numérique Tactile -->
                    <UniformGrid Columns="3" Rows="4" Margin="0,0,0,25">
                        <Button Content="7" Command="{Binding NumpadCommand}" CommandParameter="7" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" Height="65" />
                        <Button Content="8" Command="{Binding NumpadCommand}" CommandParameter="8" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" />
                        <Button Content="9" Command="{Binding NumpadCommand}" CommandParameter="9" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" />

                        <Button Content="4" Command="{Binding NumpadCommand}" CommandParameter="4" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" Height="65" />
                        <Button Content="5" Command="{Binding NumpadCommand}" CommandParameter="5" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" />
                        <Button Content="6" Command="{Binding NumpadCommand}" CommandParameter="6" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" />

                        <Button Content="1" Command="{Binding NumpadCommand}" CommandParameter="1" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" Height="65" />
                        <Button Content="2" Command="{Binding NumpadCommand}" CommandParameter="2" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" />
                        <Button Content="3" Command="{Binding NumpadCommand}" CommandParameter="3" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" />

                        <Button Content="0" Command="{Binding NumpadCommand}" CommandParameter="0" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" Height="65" />
                        <Button Content="00" Command="{Binding NumpadCommand}" CommandParameter="00" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" />
                        <Button Content="000" Command="{Binding NumpadCommand}" CommandParameter="000" Margin="3" FontSize="24" Style="{StaticResource MaterialDesignFlatLightBgButton}" />
                    </UniformGrid>

                    <!-- Actions Finales -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="ANNULER" Command="{Binding CancelCheckoutCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Foreground="Gray" BorderBrush="Gray" Height="50" FontSize="18" />
                        <Button Grid.Column="1" Content="VALIDER" Command="{Binding ConfirmCashPaymentCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5,0,0,0" Background="#43A047" BorderBrush="#43A047" Height="50" FontSize="18" />
                    </Grid>
                </StackPanel>

                <!-- CATALOGUE PRODUITS (POPUP) -->
                <Border Width="600" Height="500" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="10" Padding="20" Visibility="{Binding IsCatalogDialogOpen, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Sélectionner des Produits" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource PrimaryHueMidBrush}" />

                        <ListBox Grid.Row="1" ItemsSource="{Binding Products}" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="5" Padding="15" HorizontalAlignment="Stretch" UniformCornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Description}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:N0} FCFA}" Foreground="#43A047" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0" />
                                            <Button Grid.Column="2" Content="Ajouter" Style="{StaticResource MaterialDesignRaisedButton}" Height="35" Width="100" Background="#1E88E5" BorderBrush="#1E88E5"
                                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <Button Grid.Row="2" Content="FERMER" Command="{Binding CloseCatalogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,20,0,0" Height="45" FontSize="16" />
                    </Grid>
                </Border>

                <!-- DIALOGUE DE QUANTITÉ -->
                <StackPanel Margin="20" Width="300" Visibility="{Binding IsQuantityDialogOpen, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Quelle Quantité ?" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="-" Command="{Binding DecreaseQtyCommand}" FontSize="24" FontWeight="Bold" Height="50" Width="50" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedQuantityToAdd}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="+" Command="{Binding IncreaseQtyCommand}" FontSize="24" FontWeight="Bold" Height="50" Width="50" Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="ANNULER" Command="{Binding CancelQuantityCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Foreground="Gray" BorderBrush="Gray" Height="45" />
                        <Button Grid.Column="1" Content="AJOUTER" Command="{Binding ConfirmQuantityCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5,0,0,0" Background="#1E88E5" BorderBrush="#1E88E5" Height="45" />
                    </Grid>
                </StackPanel>
            </Grid>
        </materialDesign:DialogHost.DialogContent>

        <!-- ECRAN PRINCIPAL CAISSE (PANIER) -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header du Panier -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Votre Panier" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,20,0" />

                <!-- SCAN CODE BARRE -->
                <TextBox Grid.Column="1" Text="{Binding BarcodeSearch, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Scanner ou saisir un code-barres... (puis Entrée)" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         VerticalAlignment="Center" Margin="0,0,20,0" Height="45">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchBarcodeCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2" Command="{Binding OpenCatalogCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1E88E5" BorderBrush="#1E88E5" Height="45" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ViewList" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CATALOGUE" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Content="VIDER" Command="{Binding ClearCartCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#E53935" BorderBrush="#E53935" Height="45" FontSize="16" />
            </Grid>

            <!-- Liste des produits dans le panier -->
            <materialDesign:Card Grid.Row="1" UniformCornerRadius="10" Padding="15" Margin="0,0,0,20">
                <DataGrid ItemsSource="{Binding Cart}" AutoGenerateColumns="False" CanUserAddRows="False" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="16" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Description de l'Article" Binding="{Binding ProductDescription}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Quantité" Binding="{Binding Qty}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Prix Total" Binding="{Binding Total, StringFormat={}{0:N0} FCFA}" Width="150" IsReadOnly="True" />
                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E53935" Padding="0" Margin="0" Height="30" Width="30" HorizontalAlignment="Center"
                                            Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Zone de Paiement -->
            <materialDesign:Card Grid.Row="2" Background="{DynamicResource PrimaryHueLightBrush}" Foreground="White" UniformCornerRadius="15" Padding="25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Mode de paiement :" FontSize="16" Margin="0,0,0,5" Opacity="0.9"/>
                        <ComboBox SelectedIndex="{Binding PaymentMethodIndex}" Width="250" HorizontalAlignment="Left" Margin="0,0,0,15" Padding="10" FontSize="16" Foreground="White" Background="Transparent">
                            <ComboBoxItem Content="Espèces" Foreground="Black" />
                            <ComboBoxItem Content="Portefeuille Client" Foreground="Black" />
                        </ComboBox>

                        <!-- Visible only if Wallet is selected -->
                        <TextBox materialDesign:HintAssist.Hint="Numéro de Téléphone" 
                                 Text="{Binding CustomerPhone}" 
                                 Visibility="{Binding IsWalletPayment, Converter={StaticResource BoolToVis}}" 
                                 Width="250" HorizontalAlignment="Left" FontSize="16" Foreground="White" materialDesign:HintAssist.Foreground="White" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="MONTANT TOTAL À PAYER" FontSize="16" Opacity="0.9" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} FCFA}" FontSize="42" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,15" />

                        <Button Content="VALIDER L'ACHAT" Command="{Binding CheckoutCommand}" Style="{StaticResource MaterialDesignRaisedDarkButton}" Height="60" Width="300" FontSize="20" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
