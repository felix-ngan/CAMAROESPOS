<Window x:Class="CamaroesPOS.UI.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Reçu de Caisse" Height="700" Width="450" 
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="10">
            <Grid>
                <TextBlock Text="Reçu de Caisse" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Exporter PDF" Click="BtnExportPdf_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Margin="0,0,10,0"/>
                    <Button Content="Imprimer" Click="BtnPrint_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Margin="0,0,10,0"/>
                    <Button Content="Fermer" Click="BtnClose_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Printable Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border x:Name="PrintArea" Background="White" Margin="20" Padding="20" BorderBrush="LightGray" BorderThickness="1">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="CAMAROES" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="Black" />
                    <TextBlock Text="Votre Partenaire de Confiance" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="Gray" />
                    <TextBlock Text="Douala, Cameroun" FontSize="12" HorizontalAlignment="Center" Foreground="Black" />
                    <TextBlock Text="Tél: +237 600 000 000" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="Black" />
                    
                    <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>

                    <!-- Transaction Info -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Reçu N° :" FontSize="12" Foreground="Black"/>
                            <TextBlock x:Name="TxtTransNo" Text="2026..." FontWeight="Bold" FontSize="12" Foreground="Black"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Date :" FontSize="12" Foreground="Black"/>
                            <TextBlock x:Name="TxtDate" Text="28/07/2026 15:30" FontWeight="Bold" FontSize="12" Foreground="Black"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock x:Name="TxtMode" Text="Mode de Paiement : Espèces" FontSize="12" Margin="0,0,0,15" FontWeight="Bold" Foreground="Black"/>

                    <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>

                    <!-- Items Table Header -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Article" FontWeight="Bold" FontSize="12" Foreground="Black"/>
                        <TextBlock Grid.Column="1" Text="Qté" FontWeight="Bold" HorizontalAlignment="Center" FontSize="12" Foreground="Black"/>
                        <TextBlock Grid.Column="2" Text="Total" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" Foreground="Black"/>
                    </Grid>

                    <!-- Items List -->
                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductDescription}" FontSize="12" TextWrapping="Wrap" Foreground="Black"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Qty}" HorizontalAlignment="Center" FontSize="12" Foreground="Black"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat={}{0:N0}}" HorizontalAlignment="Right" FontSize="12" Foreground="Black"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,15,0,15"/>

                    <!-- Totals -->
                    <Grid Margin="0,0,0,5" x:Name="GridSubTotal" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sous-total :" FontSize="14" Foreground="Black"/>
                        <TextBlock Grid.Column="1" x:Name="TxtSubTotal" Text="0 FCFA" FontSize="14" HorizontalAlignment="Right" Foreground="Black"/>
                    </Grid>

                    <Grid Margin="0,0,0,10" x:Name="GridDiscount" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Réduction :" FontSize="14" Foreground="Black"/>
                        <TextBlock Grid.Column="1" x:Name="TxtDiscount" Text="0 FCFA" FontSize="14" HorizontalAlignment="Right" Foreground="Orange"/>
                    </Grid>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOTAL À PAYER :" FontWeight="Bold" FontSize="16" Foreground="Black"/>
                        <TextBlock Grid.Column="1" x:Name="TxtTotal" Text="0 FCFA" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" Foreground="Black"/>
                    </Grid>

                    <Grid Margin="0,0,0,5" x:Name="GridReceived">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Montant Reçu :" FontSize="14" Foreground="Black"/>
                        <TextBlock Grid.Column="1" x:Name="TxtReceived" Text="0 FCFA" FontSize="14" HorizontalAlignment="Right" Foreground="Black"/>
                    </Grid>

                    <Grid Margin="0,0,0,20" x:Name="GridChange">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Monnaie Rendue :" FontSize="14" Foreground="Black"/>
                        <TextBlock Grid.Column="1" x:Name="TxtChange" Text="0 FCFA" FontSize="14" HorizontalAlignment="Right" Foreground="Black"/>
                    </Grid>
                    
                    <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Merci de votre visite !" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="Black"/>
                    <TextBlock Text="Les articles vendus ne sont ni repris ni échangés." FontSize="10" HorizontalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center"/>
                    
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
