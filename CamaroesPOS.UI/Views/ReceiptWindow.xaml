<Window x:Class="CamaroesPOS.UI.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Str_ReudeCaisse_62fa}" Height="700" Width="450" 
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="10">
            <Grid>
                <TextBlock Text="{DynamicResource Str_ReudeCaisse_62fa}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Str_ExporterPDF_94c4}" Click="BtnExportPdf_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource Str_Imprimer_9430}" Click="BtnPrint_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource Str_Fermer_7d20}" Click="BtnClose_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Printable Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border x:Name="PrintArea" Background="White" Margin="20" Padding="20" BorderBrush="LightGray" BorderThickness="1">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="{DynamicResource Str_CAMAROES_f245}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="Black" />
                    <TextBlock Text="{DynamicResource Str_VotrePartenaire_7c9f}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="Gray" />
                    <TextBlock Text="{DynamicResource Str_DoualaCameroun_c28d}" FontSize="12" HorizontalAlignment="Center" Foreground="Black" />
                    <TextBlock Text="{DynamicResource Str_Tl237600000000_2edf}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="Black" />
                    
                    <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>

                    <!-- Transaction Info -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Str_ReuN_b54d}" FontSize="12" Foreground="Black"/>
                            <TextBlock x:Name="TxtTransNo" Text="{DynamicResource Str_2026_5901}" FontWeight="Bold" FontSize="12" Foreground="Black"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource Str_Date_a16b}" FontSize="12" Foreground="Black"/>
                            <TextBlock x:Name="TxtDate" Text="{DynamicResource Str_280720261530_1a9a}" FontWeight="Bold" FontSize="12" Foreground="Black"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock x:Name="TxtMode" Text="{DynamicResource Str_ModedePaiementE_69c2}" FontSize="12" Margin="0,0,0,15" FontWeight="Bold" Foreground="Black"/>

                    <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>

                    <!-- Items Table Header -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_Article_5e2f}" FontWeight="Bold" FontSize="12" Foreground="Black"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str_Qt_493a}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="12" Foreground="Black"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Str_Total_96b0}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" Foreground="Black"/>
                    </Grid>

                    <!-- Items List -->
                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductDescription}" FontSize="12" TextWrapping="Wrap" Foreground="Black"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Qty}" HorizontalAlignment="Center" FontSize="12" Foreground="Black"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat={}{0:N0}}" HorizontalAlignment="Right" FontSize="12" Foreground="Black"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,15,0,15"/>

                    <!-- Totals -->
                    <Grid Margin="0,0,0,5" x:Name="GridSubTotal" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_Soustotal_f804}" FontSize="14" Foreground="Black"/>
                        <TextBlock Grid.Column="1" x:Name="TxtSubTotal" Text="{DynamicResource Str_0FCFA_3b62}" FontSize="14" HorizontalAlignment="Right" Foreground="Black"/>
                    </Grid>

                    <Grid Margin="0,0,0,10" x:Name="GridDiscount" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_Rduction_1fbd}" FontSize="14" Foreground="Black"/>
                        <TextBlock Grid.Column="1" x:Name="TxtDiscount" Text="{DynamicResource Str_0FCFA_3b62}" FontSize="14" HorizontalAlignment="Right" Foreground="Orange"/>
                    </Grid>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_TOTALPAYER_6722}" FontWeight="Bold" FontSize="16" Foreground="Black"/>
                        <TextBlock Grid.Column="1" x:Name="TxtTotal" Text="{DynamicResource Str_0FCFA_3b62}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" Foreground="Black"/>
                    </Grid>

                    <Grid Margin="0,0,0,5" x:Name="GridReceived">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_MontantReu_2e3b}" FontSize="14" Foreground="Black"/>
                        <TextBlock Grid.Column="1" x:Name="TxtReceived" Text="{DynamicResource Str_0FCFA_3b62}" FontSize="14" HorizontalAlignment="Right" Foreground="Black"/>
                    </Grid>

                    <Grid Margin="0,0,0,20" x:Name="GridChange">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_MonnaieRendue_8852}" FontSize="14" Foreground="Black"/>
                        <TextBlock Grid.Column="1" x:Name="TxtChange" Text="{DynamicResource Str_0FCFA_3b62}" FontSize="14" HorizontalAlignment="Right" Foreground="Black"/>
                    </Grid>
                    
                    <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="{DynamicResource Str_Mercidevotrevis_4a05}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="Black"/>
                    <TextBlock Text="{DynamicResource Str_Lesarticlesvend_ba7a}" FontSize="10" HorizontalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center"/>
                    
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
