<UserControl x:Class="CamaroesPOS.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
             Background="Transparent">
    <UserControl.DataContext>
        <viewmodels:ReportsViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filtres Globaux -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,20" Padding="20" UniformCornerRadius="15" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="{DynamicResource Str_Datededbut_b9af}" SelectedDate="{Binding StartDate}" Margin="0,0,20,0" Width="150" FontSize="16" />
                <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="{DynamicResource Str_Datedefin_806e}" SelectedDate="{Binding EndDate}" Margin="0,0,20,0" Width="150" FontSize="16" />
                
                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="{DynamicResource Str_Rechercheglobal_1043}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,20,0" FontSize="16" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                <Button Grid.Column="3" Content="{DynamicResource Str_FILTRER_d94c}" Command="{Binding FilterCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1E88E5" BorderBrush="#1E88E5" Margin="0,0,10,0" Height="40" />
                <Button Grid.Column="4" Content="{DynamicResource Str_RINITIALISER_6f47}" Command="{Binding ResetFilterCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#E53935" BorderBrush="#E53935" Margin="0,0,10,0" Height="40" />
                <Button Grid.Column="5" Content="{DynamicResource Str_EXPORTERPDF_8383}" Command="{Binding ExportPdfCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#43A047" BorderBrush="#43A047" Height="40">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Margin="0,0,5,0" />
                                <TextBlock Text="{DynamicResource Str_EXPORTERPDF_8383}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- TabControl for different reports -->
        <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="PrimaryMid" materialDesign:ColorZoneAssist.Background="Transparent">
            <!-- TAB: VENTES -->
            <TabItem Header="{DynamicResource Str_RapportdesVente_f50d}">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:Card Grid.Column="0" Margin="0,0,10,0" Padding="15" Background="White" UniformCornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2F1" CornerRadius="12" Width="50" Height="50" Margin="0,0,15,0">
                                    <materialDesign:PackIcon Kind="Bank" Width="30" Height="30" Foreground="#00897B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_ChiffredAffaire_90ea}" FontSize="14" Foreground="#8F9BBA" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalSalesAmount, StringFormat={}{0:N0} FCFA}" FontSize="22" FontWeight="Bold" Foreground="#2B3674" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                        
                        <materialDesign:Card Grid.Column="1" Margin="10,0,0,0" Padding="15" Background="White" UniformCornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#FFF3E0" CornerRadius="12" Width="50" Height="50" Margin="0,0,15,0">
                                    <materialDesign:PackIcon Kind="CartOutline" Width="30" Height="30" Foreground="#F39C12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_ArticlesVendus_a9a2}" FontSize="14" Foreground="#8F9BBA" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalItemsSold}" FontSize="22" FontWeight="Bold" Foreground="#2B3674" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                    
                    <materialDesign:Card Grid.Row="1" Padding="10" UniformCornerRadius="15" Background="White">
                        <DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Str_DateampHeure_f673}" Binding="{Binding SoldDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" />
                                <DataGridTextColumn Header="{DynamicResource Str_NTransaction_aaf6}" Binding="{Binding TransNo}" Width="150" />
                                <DataGridTextColumn Header="{DynamicResource Str_Produit_e30e}" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="{DynamicResource Str_Qt_493a}" Binding="{Binding Qty}" Width="80" />
                                <DataGridTextColumn Header="{DynamicResource Str_Total_96b0}" Binding="{Binding Total, StringFormat={}{0:N0} FCFA}" Width="120" />
                                <DataGridTextColumn Header="{DynamicResource Str_Caissier_4c93}" Binding="{Binding Cashier}" Width="120" />
                                
                                <DataGridTemplateColumn Header="{DynamicResource Str_Action_004b}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E53935" Command="{Binding DataContext.CancelTransactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Height="30" Padding="5,0" ToolTip="Annuler cette vente" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Cancel" Width="18" Height="18" VerticalAlignment="Center" />
                                                    <TextBlock Text="{DynamicResource Str_Annuler_d12c}" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
            
            <!-- TAB: PRODUITS (INVENTAIRE) -->
            <TabItem Header="{DynamicResource Str_StockActuel_aa7a}">
                <materialDesign:Card Margin="0,15,0,0" Padding="10" UniformCornerRadius="15" Background="White">
                    <DataGrid ItemsSource="{Binding ProductsList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_CodeProduit_ba21}" Binding="{Binding ProductCode}" Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Str_Description_b5a7}" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource Str_Marque_a3e2}" Binding="{Binding BrandName}" Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Str_Catgorie_8c6b}" Binding="{Binding CategoryName}" Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Str_Quantit_1b27}" Binding="{Binding Qty}" Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Str_PrixVente_5076}" Binding="{Binding Price, StringFormat={}{0:N0} FCFA}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

            <!-- TAB: HISTORIQUE DES STOCKS -->
            <TabItem Header="{DynamicResource Str_HistoriquedesSt_6c30}">
                <materialDesign:Card Margin="0,15,0,0" Padding="10" UniformCornerRadius="15" Background="White">
                    <DataGrid ItemsSource="{Binding StockHistoryList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_DateAjout_d98d}" Binding="{Binding StockInDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" />
                            <DataGridTextColumn Header="{DynamicResource Str_Rf_2a02}" Binding="{Binding RefNo}" Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Str_Produit_e30e}" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource Str_Fournisseur_73d1}" Binding="{Binding VendorName}" Width="150" />
                            <DataGridTextColumn Header="{DynamicResource Str_QtAjoute_c10f}" Binding="{Binding Qty}" Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Str_AjoutPar_39b8}" Binding="{Binding StockInBy}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

            <!-- TAB: ANNULATIONS -->
            <TabItem Header="{DynamicResource Str_OrdresAnnuls_9bcd}">
                <materialDesign:Card Margin="0,15,0,0" Padding="10" UniformCornerRadius="15" Background="White">
                    <DataGrid ItemsSource="{Binding CancelledOrdersList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_DateVente_bce3}" Binding="{Binding SoldDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" />
                            <DataGridTextColumn Header="{DynamicResource Str_NTrans_5ce4}" Binding="{Binding TransNo}" Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Str_Produit_e30e}" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource Str_Total_96b0}" Binding="{Binding Total, StringFormat={}{0:N0} FCFA}" Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Str_AnnulPar_2760}" Binding="{Binding CancelledBy}" Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Str_Raison_7f06}" Binding="{Binding Reason}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

            <!-- TAB: PORTEFEUILLES -->
            <TabItem Header="{DynamicResource Str_OprationsPortef_45a1}">
                <materialDesign:Card Margin="0,15,0,0" Padding="10" UniformCornerRadius="15" Background="White">
                    <DataGrid ItemsSource="{Binding WalletTransactionsList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_DateampHeure_f673}" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" />
                            <DataGridTextColumn Header="{DynamicResource Str_NTrans_5ce4}" Binding="{Binding TransNo}" Width="150" />
                            <DataGridTextColumn Header="{DynamicResource Str_Tlphone_301d}" Binding="{Binding Phone}" Width="150" />
                            <DataGridTextColumn Header="{DynamicResource Str_Type_a1fa}" Binding="{Binding Type}" Width="100" />
                            <DataGridTextColumn Header="{DynamicResource Str_Montant_4dd4}" Binding="{Binding Amount, StringFormat={}{0:N0} FCFA}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
