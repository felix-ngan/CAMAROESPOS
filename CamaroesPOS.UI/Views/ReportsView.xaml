<UserControl x:Class="CamaroesPOS.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
             Background="Transparent">
    <UserControl.DataContext>
        <viewmodels:ReportsViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filtres Globaux -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,20" Padding="20" UniformCornerRadius="15" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="Date de début" SelectedDate="{Binding StartDate}" Margin="0,0,20,0" Width="150" FontSize="16" />
                <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="Date de fin" SelectedDate="{Binding EndDate}" Margin="0,0,20,0" Width="150" FontSize="16" />
                
                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Recherche globale" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,20,0" FontSize="16" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                <Button Grid.Column="3" Content="FILTRER" Command="{Binding FilterCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1E88E5" BorderBrush="#1E88E5" Margin="0,0,10,0" Height="40" />
                <Button Grid.Column="4" Content="RÉINITIALISER" Command="{Binding ResetFilterCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#E53935" BorderBrush="#E53935" Margin="0,0,10,0" Height="40" />
                <Button Grid.Column="5" Content="EXPORTER PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#43A047" BorderBrush="#43A047" Height="40">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Margin="0,0,5,0" />
                                <TextBlock Text="EXPORTER PDF" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- TabControl for different reports -->
        <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="PrimaryMid" materialDesign:ColorZoneAssist.Background="Transparent">
            <!-- TAB: VENTES -->
            <TabItem Header="Rapport des Ventes">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:Card Grid.Column="0" Margin="0,0,10,0" Padding="15" Background="White" UniformCornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2F1" CornerRadius="12" Width="50" Height="50" Margin="0,0,15,0">
                                    <materialDesign:PackIcon Kind="Bank" Width="30" Height="30" Foreground="#00897B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Chiffre d'Affaires" FontSize="14" Foreground="#8F9BBA" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalSalesAmount, StringFormat={}{0:N0} FCFA}" FontSize="22" FontWeight="Bold" Foreground="#2B3674" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                        
                        <materialDesign:Card Grid.Column="1" Margin="10,0,0,0" Padding="15" Background="White" UniformCornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#FFF3E0" CornerRadius="12" Width="50" Height="50" Margin="0,0,15,0">
                                    <materialDesign:PackIcon Kind="CartOutline" Width="30" Height="30" Foreground="#F39C12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Articles Vendus" FontSize="14" Foreground="#8F9BBA" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalItemsSold}" FontSize="22" FontWeight="Bold" Foreground="#2B3674" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                    
                    <materialDesign:Card Grid.Row="1" Padding="10" UniformCornerRadius="15" Background="White">
                        <DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date &amp; Heure" Binding="{Binding SoldDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" />
                                <DataGridTextColumn Header="N° Transaction" Binding="{Binding TransNo}" Width="150" />
                                <DataGridTextColumn Header="Produit" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="Qté" Binding="{Binding Qty}" Width="80" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N0} FCFA}" Width="120" />
                                <DataGridTextColumn Header="Caissier" Binding="{Binding Cashier}" Width="120" />
                                
                                <DataGridTemplateColumn Header="Action" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E53935" Command="{Binding DataContext.CancelTransactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Height="30" Padding="5,0" ToolTip="Annuler cette vente" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Cancel" Width="18" Height="18" VerticalAlignment="Center" />
                                                    <TextBlock Text="Annuler" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
            
            <!-- TAB: PRODUITS (INVENTAIRE) -->
            <TabItem Header="Stock Actuel">
                <materialDesign:Card Margin="0,15,0,0" Padding="10" UniformCornerRadius="15" Background="White">
                    <DataGrid ItemsSource="{Binding ProductsList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code Produit" Binding="{Binding ProductCode}" Width="120" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Marque" Binding="{Binding BrandName}" Width="120" />
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding CategoryName}" Width="120" />
                            <DataGridTextColumn Header="Quantité" Binding="{Binding Qty}" Width="120" />
                            <DataGridTextColumn Header="Prix Vente" Binding="{Binding Price, StringFormat={}{0:N0} FCFA}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

            <!-- TAB: HISTORIQUE DES STOCKS -->
            <TabItem Header="Historique des Stocks">
                <materialDesign:Card Margin="0,15,0,0" Padding="10" UniformCornerRadius="15" Background="White">
                    <DataGrid ItemsSource="{Binding StockHistoryList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date Ajout" Binding="{Binding StockInDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" />
                            <DataGridTextColumn Header="Réf." Binding="{Binding RefNo}" Width="120" />
                            <DataGridTextColumn Header="Produit" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Fournisseur" Binding="{Binding VendorName}" Width="150" />
                            <DataGridTextColumn Header="Qté Ajoutée" Binding="{Binding Qty}" Width="120" />
                            <DataGridTextColumn Header="Ajouté Par" Binding="{Binding StockInBy}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

            <!-- TAB: ANNULATIONS -->
            <TabItem Header="Ordres Annulés">
                <materialDesign:Card Margin="0,15,0,0" Padding="10" UniformCornerRadius="15" Background="White">
                    <DataGrid ItemsSource="{Binding CancelledOrdersList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date Vente" Binding="{Binding SoldDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" />
                            <DataGridTextColumn Header="N° Trans" Binding="{Binding TransNo}" Width="120" />
                            <DataGridTextColumn Header="Produit" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N0} FCFA}" Width="120" />
                            <DataGridTextColumn Header="Annulé Par" Binding="{Binding CancelledBy}" Width="120" />
                            <DataGridTextColumn Header="Raison" Binding="{Binding Reason}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

            <!-- TAB: PORTEFEUILLES -->
            <TabItem Header="Opérations Portefeuille">
                <materialDesign:Card Margin="0,15,0,0" Padding="10" UniformCornerRadius="15" Background="White">
                    <DataGrid ItemsSource="{Binding WalletTransactionsList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date &amp; Heure" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" />
                            <DataGridTextColumn Header="N° Trans" Binding="{Binding TransNo}" Width="150" />
                            <DataGridTextColumn Header="Téléphone" Binding="{Binding Phone}" Width="150" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
                            <DataGridTextColumn Header="Montant" Binding="{Binding Amount, StringFormat={}{0:N0} FCFA}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
