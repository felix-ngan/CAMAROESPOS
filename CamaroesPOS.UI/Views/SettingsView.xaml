<UserControl x:Class="CamaroesPOS.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
             Background="Transparent">
    <UserControl.DataContext>
        <viewmodels:SettingsViewModel />
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="Settings" Width="30" Height="30" VerticalAlignment="Center" Foreground="#1E88E5"/>
            <TextBlock Text="{DynamicResource Str_ParamtresGnraux_22ee}" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#2B3674" />
        </StackPanel>

        <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="PrimaryMid" materialDesign:ColorZoneAssist.Background="Transparent">
            <!-- TAB: UTILISATEURS -->
            <TabItem Header="{DynamicResource Str_GestiondesUtili_97ce}">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Padding="15" UniformCornerRadius="15" Margin="0,0,20,0" Background="White">
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Str_Identifiant_c943}" Binding="{Binding Username}" Width="*" />
                                <DataGridTextColumn Header="{DynamicResource Str_NomComplet_088b}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{DynamicResource Str_Rle_1977}" Binding="{Binding Role}" Width="100" />
                                <DataGridCheckBoxColumn Header="{DynamicResource Str_Actif_a9f3}" Binding="{Binding IsActive}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Padding="20" UniformCornerRadius="15" Background="White">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_DtailsUtilisate_74be}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2B3674" />
                                
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_Nomdutilisateur_299a}" Text="{Binding NewUsername}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" FontSize="16" />
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_NomComplet_088b}" Text="{Binding NewName}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" FontSize="16" />
                                
                                <!-- Fake PasswordBox just with text for simplicity in this POS -->
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_MotdePasse_6224}" Text="{Binding NewPassword}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" FontSize="16" />
                                
                                <ComboBox materialDesign:HintAssist.Hint="{DynamicResource Str_Rledelutilisate_bb27}" Text="{Binding NewRole}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,15" FontSize="16">
                                    <ComboBoxItem Content="{DynamicResource Str_Admin_e3af}" />
                                    <ComboBoxItem Content="{DynamicResource Str_Cashier_e7f8}" />
                                </ComboBox>
                                
                                <CheckBox Content="{DynamicResource Str_CompteActif_e821}" IsChecked="{Binding IsActiveUser}" Margin="0,0,0,30" FontSize="14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                     <Button Grid.Column="0" Content="{DynamicResource Str_NOUVEAU_dcef}" Command="{Binding ClearUserCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Foreground="Gray" BorderBrush="Gray" Height="45" FontSize="14" FontWeight="Bold" />
                                     <Button Grid.Column="1" Command="{Binding SaveUserCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5,0,0,0" Background="#1E88E5" BorderBrush="#1E88E5" Height="45">
                                         <StackPanel Orientation="Horizontal">
                                             <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" VerticalAlignment="Center" Foreground="White" />
                                             <TextBlock Text="{DynamicResource Str_ENREGISTRER_6d15}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White" />
                                         </StackPanel>
                                     </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- TAB: SYSTÈME -->
            <TabItem Header="{DynamicResource Str_ParamtresSystme_ee31}">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="600" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Padding="30" UniformCornerRadius="15" Background="White">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Informationsdel_2e55}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2B3674" />
                            
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_NomdelaBoutique_af7e}" Text="{Binding StoreName}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,20" FontSize="18" />
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_AdresseCompltea_c08a}" Text="{Binding StoreAddress}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,20" FontSize="18" />
                            
                            <TextBlock Text="{DynamicResource Str_PaiementsMobile_7eff}" FontSize="16" FontWeight="Bold" Margin="0,10,0,10" Foreground="Gray" />
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_CodeMarchandMTN_6e81}" Text="{Binding MomoCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,20" FontSize="18" />
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource Str_CodeMarchandOra_11ba}" Text="{Binding OrangeCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,30" FontSize="18" />

                            <Button Command="{Binding SaveStoreCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#43A047" BorderBrush="#43A047" Height="55" Margin="0,15,0,0" materialDesign:ButtonAssist.CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveAll" Width="26" Height="26" VerticalAlignment="Center" Foreground="White" />
                                    <TextBlock Text="{DynamicResource Str_ENREGISTRERLESP_e12e}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
            <!-- TAB: SÉCURITÉ -->
            <TabItem Header="{DynamicResource Str_Scurit_f020}">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="600" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Padding="30" UniformCornerRadius="15" Background="White">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_ChangermonMotde_0861}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2B3674" />
                            
                            <PasswordBox materialDesign:HintAssist.Hint="{DynamicResource Str_Ancienmotdepass_6082}" PasswordChanged="OldPassword_Changed" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,20" FontSize="18" />
                            <PasswordBox materialDesign:HintAssist.Hint="{DynamicResource Str_Nouveaumotdepas_d383}" PasswordChanged="NewPassword_Changed" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,20" FontSize="18" />
                            <PasswordBox materialDesign:HintAssist.Hint="{DynamicResource Str_Confirmerlenouv_1c8c}" PasswordChanged="ConfirmPassword_Changed" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,30" FontSize="18" />

                            <Button Command="{Binding ChangePasswordCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E53935" BorderBrush="#E53935" Height="55" Margin="0,15,0,0" materialDesign:ButtonAssist.CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="KeyVariant" Width="26" Height="26" VerticalAlignment="Center" Foreground="White" />
                                    <TextBlock Text="{DynamicResource Str_METTREJOURLEMOT_435f}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
