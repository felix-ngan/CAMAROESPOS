<UserControl x:Class="CamaroesPOS.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:CamaroesPOS.UI.ViewModels"
             Background="{DynamicResource MaterialDesignPaper}">
    <UserControl.DataContext>
        <viewmodels:SettingsViewModel />
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="Settings" Width="30" Height="30" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Paramètres Généraux" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="PrimaryMid" materialDesign:ColorZoneAssist.Background="Transparent">
            <!-- TAB: UTILISATEURS -->
            <TabItem Header="Gestion des Utilisateurs">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Padding="15" UniformCornerRadius="10" Margin="0,0,20,0">
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Identifiant (Username)" Binding="{Binding Username}" Width="*" />
                                <DataGridTextColumn Header="Nom Complet" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="100" />
                                <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Padding="20" UniformCornerRadius="10" Background="{DynamicResource MaterialDesignPaper}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Détails Utilisateur" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                
                                <TextBox materialDesign:HintAssist.Hint="Nom d'utilisateur (Username)" Text="{Binding NewUsername}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" FontSize="16" />
                                <TextBox materialDesign:HintAssist.Hint="Nom Complet" Text="{Binding NewName}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" FontSize="16" />
                                
                                <!-- Fake PasswordBox just with text for simplicity in this POS -->
                                <TextBox materialDesign:HintAssist.Hint="Mot de Passe" Text="{Binding NewPassword}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" FontSize="16" />
                                
                                <ComboBox materialDesign:HintAssist.Hint="Rôle de l'utilisateur" Text="{Binding NewRole}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,15" FontSize="16">
                                    <ComboBoxItem Content="Admin" />
                                    <ComboBoxItem Content="Cashier" />
                                </ComboBox>
                                
                                <CheckBox Content="Compte Actif (Autorisé à se connecter)" IsChecked="{Binding IsActiveUser}" Margin="0,0,0,30" FontSize="14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="NOUVEAU" Command="{Binding ClearUserCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Foreground="Gray" BorderBrush="Gray" />
                                    <Button Grid.Column="1" Content="ENREGISTRER" Command="{Binding SaveUserCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5,0,0,0" Background="#1E88E5" BorderBrush="#1E88E5" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- TAB: SYSTÈME -->
            <TabItem Header="Paramètres Système (Boutique)">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="600" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Padding="30" UniformCornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Informations de la Boutique" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            
                            <TextBox materialDesign:HintAssist.Hint="Nom de la Boutique / Entreprise" Text="{Binding StoreName}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,20" FontSize="18" />
                            <TextBox materialDesign:HintAssist.Hint="Adresse Complète &amp; Contact" Text="{Binding StoreAddress}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,20" FontSize="18" />
                            
                            <TextBlock Text="Paiements Mobiles" FontSize="16" FontWeight="Bold" Margin="0,10,0,10" Foreground="Gray" />
                            <TextBox materialDesign:HintAssist.Hint="Code Marchand MTN MoMo" Text="{Binding MomoCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,20" FontSize="18" />
                            <TextBox materialDesign:HintAssist.Hint="Code Marchand Orange Money" Text="{Binding OrangeCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,30" FontSize="18" />

                            <Button Content="ENREGISTRER LES PARAMÈTRES" Command="{Binding SaveStoreCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#43A047" BorderBrush="#43A047" Height="45" FontSize="16"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
            <!-- TAB: SÉCURITÉ (MON PROFIL) -->
            <TabItem Header="Sécurité (Mon Profil)">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="600" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Padding="30" UniformCornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Changer mon Mot de Passe" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            
                            <PasswordBox materialDesign:HintAssist.Hint="Ancien mot de passe" PasswordChanged="OldPassword_Changed" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,20" FontSize="18" />
                            <PasswordBox materialDesign:HintAssist.Hint="Nouveau mot de passe" PasswordChanged="NewPassword_Changed" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,20" FontSize="18" />
                            <PasswordBox materialDesign:HintAssist.Hint="Confirmer le nouveau mot de passe" PasswordChanged="ConfirmPassword_Changed" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,30" FontSize="18" />

                            <Button Content="METTRE À JOUR LE MOT DE PASSE" Command="{Binding ChangePasswordCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E53935" BorderBrush="#E53935" Height="45" FontSize="16"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
