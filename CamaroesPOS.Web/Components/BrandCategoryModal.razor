@inject PosStoreState Store
@inject BrowserStorageService Storage
@inject SessionState Session
@inject LocalizationService Loc

@if (IsOpen)
{
    <div class="modal-backdrop" role="presentation" @onclick="OnClose">
        <div class="modal-box modal-lg stack" role="dialog" aria-modal="true" aria-labelledby="bc-modal-title" @onclick:stopPropagation="true">
            <div class="row-between">
                <h2 id="bc-modal-title" class="card-title" style="margin:0;">@Loc.T("Inv_BrandsCategories")</h2>
                <button type="button" class="btn btn-icon btn-outlined" aria-label="@Loc.T("Btn_Close")" @onclick="OnClose">
                    <Icon Name="x" Size="16" />
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_msg))
            {
                <div class="alert @(_err ? "alert-error" : "alert-success")" role="alert">@_msg</div>
            }

            <div class="grid-2">
                <!-- Brands -->
                <div class="card stack" style="box-shadow:none;">
                    <h3 class="card-title" style="margin:0;">@Loc.T("Col_Brand")</h3>
                    <form class="row-nowrap" @onsubmit="SaveBrandAsync" @onsubmit:preventDefault="true">
                        <input class="input" style="flex:1;" aria-label="@Loc.T("Col_Brand")" @bind="_brandName" placeholder="@Loc.T("Col_Brand")" />
                        <button type="submit" class="btn btn-primary btn-sm">@Loc.T("Btn_Save")</button>
                        @if (_editBrandId.HasValue)
                        {
                            <button type="button" class="btn btn-icon btn-outlined" aria-label="@Loc.T("Btn_Cancel")" @onclick="CancelBrand">
                                <Icon Name="x" Size="15" />
                            </button>
                        }
                    </form>
                    <table class="data-table">
                        <tbody>
                            @foreach (var b in Store.Brands)
                            {
                                <tr>
                                    <td>@b.BrandName</td>
                                    <td class="actions-cell">
                                        <div class="row-nowrap">
                                            <button type="button" class="btn btn-outlined btn-icon" aria-label="@($"Modifier {b.BrandName}")" @onclick="() => { _editBrandId = b.Id; _brandName = b.BrandName; }">
                                                <Icon Name="edit" Size="14" />
                                            </button>
                                            <button type="button" class="btn btn-danger btn-icon" aria-label="@($"Supprimer {b.BrandName}")" @onclick="() => DeleteBrandAsync(b.Id)">
                                                <Icon Name="trash" Size="14" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Categories -->
                <div class="card stack" style="box-shadow:none;">
                    <h3 class="card-title" style="margin:0;">@Loc.T("Col_Category")</h3>
                    <form class="row-nowrap" @onsubmit="SaveCatAsync" @onsubmit:preventDefault="true">
                        <input class="input" style="flex:1;" aria-label="@Loc.T("Col_Category")" @bind="_catName" placeholder="@Loc.T("Col_Category")" />
                        <button type="submit" class="btn btn-primary btn-sm">@Loc.T("Btn_Save")</button>
                        @if (_editCatId.HasValue)
                        {
                            <button type="button" class="btn btn-icon btn-outlined" aria-label="@Loc.T("Btn_Cancel")" @onclick="CancelCat">
                                <Icon Name="x" Size="15" />
                            </button>
                        }
                    </form>
                    <table class="data-table">
                        <tbody>
                            @foreach (var c in Store.Categories)
                            {
                                <tr>
                                    <td>@c.CategoryName</td>
                                    <td class="actions-cell">
                                        <div class="row-nowrap">
                                            <button type="button" class="btn btn-outlined btn-icon" aria-label="@($"Modifier {c.CategoryName}")" @onclick="() => { _editCatId = c.Id; _catName = c.CategoryName; }">
                                                <Icon Name="edit" Size="14" />
                                            </button>
                                            <button type="button" class="btn btn-danger btn-icon" aria-label="@($"Supprimer {c.CategoryName}")" @onclick="() => DeleteCatAsync(c.Id)">
                                                <Icon Name="trash" Size="14" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int? _editBrandId;
    private string _brandName = string.Empty;
    private int? _editCatId;
    private string _catName = string.Empty;
    private string _msg = string.Empty;
    private bool _err;

    private async Task SaveBrandAsync()
    {
        var res = Store.SaveBrand(_editBrandId, _brandName.Trim(), Session.IsAdmin);
        _msg = res.Message; _err = !res.Success;
        if (res.Success) { CancelBrand(); await Storage.PersistAsync(Store); }
    }

    private void CancelBrand() { _editBrandId = null; _brandName = string.Empty; }

    private async Task DeleteBrandAsync(int id)
    {
        var res = Store.DeleteBrand(id, Session.IsAdmin);
        _msg = res.Message; _err = !res.Success;
        if (res.Success) await Storage.PersistAsync(Store);
    }

    private async Task SaveCatAsync()
    {
        var res = Store.SaveCategory(_editCatId, _catName.Trim(), Session.IsAdmin);
        _msg = res.Message; _err = !res.Success;
        if (res.Success) { CancelCat(); await Storage.PersistAsync(Store); }
    }

    private void CancelCat() { _editCatId = null; _catName = string.Empty; }

    private async Task DeleteCatAsync(int id)
    {
        var res = Store.DeleteCategory(id, Session.IsAdmin);
        _msg = res.Message; _err = !res.Success;
        if (res.Success) await Storage.PersistAsync(Store);
    }
}
