@using System.Globalization
@inject LocalizationService Loc

<div class="chart-box">
    @if (!string.IsNullOrEmpty(_hoveredText))
    {
        <div class="chart-tooltip" role="status">@_hoveredText</div>
    }
    @if (Items.Count == 0)
    {
        <div style="padding:32px;text-align:center;color:var(--muted);font-size:13px;">@Loc.T("Lbl_NoData")</div>
    }
    else
    {
        <svg viewBox="0 0 480 212" style="width:100%;height:auto;display:block;" role="img" aria-label="Graphique en barres">
            <line x1="20" y1="164" x2="464" y2="164" stroke="var(--border)" stroke-width="1.5" />
            @{
                double max = Items.Max(i => Math.Abs(i.Value));
                if (max <= 0) max = 1;
                double slot = 432.0 / Items.Count;
                double barW = Math.Min(50, slot * 0.56);
            }
            @for (int i = 0; i < Items.Count; i++)
            {
                var item = Items[i];
                double ratio = Math.Clamp(Math.Max(0, item.Value) / max, 0, 1);
                double h = Math.Max(4, ratio * 128);
                double x = 24 + i * slot + (slot - barW) / 2;
                double y = 164 - h;
                string color = Colors[i % Colors.Length];
                string tip = $"{item.Label} : {item.Value:N0}";

                <rect x="@F(x)" y="@F(y)" width="@F(barW)" height="@F(h)" rx="6" fill="@color"
                      style="cursor:pointer;"
                      @onmouseenter="() => _hoveredText = tip"
                      @onclick="() => _hoveredText = tip"
                      @onmouseleave="() => _hoveredText = null">
                    <title>@tip</title>
                </rect>
                @((MarkupString)$"<text x=\"{F(x + barW / 2)}\" y=\"{F(y - 6)}\" text-anchor=\"middle\" font-size=\"10.5\" font-weight=\"700\" fill=\"var(--navy)\">{System.Net.WebUtility.HtmlEncode(FormatShort(item.Value))}</text>")
                @((MarkupString)$"<text x=\"{F(x + barW / 2)}\" y=\"184\" text-anchor=\"middle\" font-size=\"10.5\" fill=\"var(--muted)\">{System.Net.WebUtility.HtmlEncode(Truncate(item.Label, 15))}</text>")
            }
        </svg>
    }
</div>

@code {
    [Parameter] public List<(string Label, double Value)> Items { get; set; } = new();
    [Parameter] public string[] Colors { get; set; } = new[] { "#1D72E8", "#7E57C2", "#0D9488", "#D97706", "#15803D" };

    private string? _hoveredText;

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Truncate(string s, int max) => s.Length <= max ? s : s[..(max - 1)] + "…";
    private static string FormatShort(double v) => v >= 1_000_000 ? $"{v / 1_000_000:0.#}M" : v >= 1_000 ? $"{v / 1_000:0.#}k" : v.ToString("N0");
}
