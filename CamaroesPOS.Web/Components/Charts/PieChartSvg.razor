@using System.Globalization
@inject LocalizationService Loc

<div class="chart-box" style="display:flex;flex-direction:column;align-items:center;">
    @if (!string.IsNullOrEmpty(_hoveredText))
    {
        <div class="chart-tooltip" role="status">@_hoveredText</div>
    }
    @{
        double total = Items.Sum(i => Math.Max(0, i.Value));
    }
    @if (Items.Count == 0 || total <= 0)
    {
        <div style="padding:36px;text-align:center;color:var(--muted);font-size:13px;">@Loc.T("Lbl_NoData")</div>
    }
    else
    {
        <svg viewBox="0 0 180 180" style="width:168px;height:168px;display:block;" role="img" aria-label="Graphique circulaire">
            @{
                double startAngle = -90;
                int idx = 0;
            }
            @foreach (var item in Items.Where(x => x.Value > 0))
            {
                double pct = item.Value / total;
                double sweep = pct * 360.0;
                string color = Colors[idx++ % Colors.Length];
                string tip = $"{item.Label} : {item.Value:N0} ({pct * 100:0.#}%)";
                if (sweep >= 359.9)
                {
                    <circle cx="90" cy="90" r="64" fill="none" stroke="@color" stroke-width="26"
                            style="cursor:pointer;"
                            @onmouseenter="() => _hoveredText = tip"
                            @onclick="() => _hoveredText = tip"
                            @onmouseleave="() => _hoveredText = null">
                        <title>@tip</title>
                    </circle>
                }
                else
                {
                    <path d="@DescribeArc(90, 90, 64, startAngle, startAngle + sweep)" fill="none" stroke="@color" stroke-width="26"
                          style="cursor:pointer;"
                          @onmouseenter="() => _hoveredText = tip"
                          @onclick="() => _hoveredText = tip"
                          @onmouseleave="() => _hoveredText = null">
                        <title>@tip</title>
                    </path>
                }
                startAngle += sweep;
            }
            <text x="90" y="95" text-anchor="middle" font-size="13.5" font-weight="800" fill="var(--navy)">@FormatShort(total)</text>
        </svg>

        <div class="chart-legend" style="justify-content:center;">
            @{ int c = 0; }
            @foreach (var item in Items)
            {
                string color = Colors[c++ % Colors.Length];
                double pct = total > 0 ? (item.Value / total) * 100.0 : 0;
                <span class="legend-item">
                    <span class="legend-dot" style="background:@color"></span>
                    @item.Label (@FormatShort(item.Value) · @pct.ToString("0")%)
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<(string Label, double Value)> Items { get; set; } = new();
    [Parameter] public string[] Colors { get; set; } = new[] { "#1D72E8", "#15803D", "#D97706", "#EA580C", "#7E57C2", "#0D9488" };

    private string? _hoveredText;

    private static string DescribeArc(double cx, double cy, double r, double startDeg, double endDeg)
    {
        var (sx, sy) = Polar(cx, cy, r, startDeg);
        var (ex, ey) = Polar(cx, cy, r, endDeg);
        int largeArc = (endDeg - startDeg) > 180 ? 1 : 0;
        return $"M {F(sx)} {F(sy)} A {F(r)} {F(r)} 0 {largeArc} 1 {F(ex)} {F(ey)}";
    }

    private static (double X, double Y) Polar(double cx, double cy, double r, double deg)
    {
        double rad = deg * Math.PI / 180.0;
        return (cx + r * Math.Cos(rad), cy + r * Math.Sin(rad));
    }

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string FormatShort(double v) => v >= 1_000_000 ? $"{v / 1_000_000:0.#}M" : v >= 1_000 ? $"{v / 1_000:0.#}k" : v.ToString("N0");
}
