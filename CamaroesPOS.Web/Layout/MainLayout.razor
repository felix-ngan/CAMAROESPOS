@inherits LayoutComponentBase
@implements IDisposable
@inject SessionState Session
@inject PosStoreState Store
@inject BrowserStorageService Storage
@inject LocalizationService Loc
@inject NavigationManager Nav

<div class="app-shell">
    @if (_mobileOpen)
    {
        <div class="sidebar-backdrop" @onclick="() => _mobileOpen = false"></div>
    }

    <aside class="sidebar @(_mobileOpen ? "open" : "") no-print" aria-label="Navigation principale">
        <div class="brand-header">
            <div class="brand-icon" aria-hidden="true">C</div>
            <div>
                <div class="brand-name">CAMAROES</div>
                <div class="brand-sub">POS SYSTEM · v2.0</div>
            </div>
        </div>

        <nav class="nav-list" @onclick="() => _mobileOpen = false">
            @if (Session.IsAdmin)
            {
                <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                    <Icon Name="dashboard" /><span>@Loc.T("Nav_Dashboard")</span>
                </NavLink>
            }

            <NavLink class="nav-item" href="pos">
                <Icon Name="pos" /><span>@Loc.T("Nav_POS")</span>
            </NavLink>

            <NavLink class="nav-item" href="inventory">
                <Icon Name="inventory" /><span>@Loc.T("Nav_Inventory")</span>
            </NavLink>

            <NavLink class="nav-item" href="wallets">
                <Icon Name="users" /><span>@Loc.T("Nav_Wallets")</span>
            </NavLink>

            <NavLink class="nav-item" href="vendors">
                <Icon Name="truck" /><span>@Loc.T("Nav_Vendors")</span>
            </NavLink>

            <NavLink class="nav-item" href="reports">
                <Icon Name="reports" /><span>@Loc.T("Nav_Reports")</span>
            </NavLink>

            @if (Session.IsAdmin)
            {
                <NavLink class="nav-item" href="expenses">
                    <Icon Name="expenses" /><span>@Loc.T("Nav_Expenses")</span>
                </NavLink>

                <NavLink class="nav-item" href="settings">
                    <Icon Name="settings" /><span>@Loc.T("Nav_Settings")</span>
                </NavLink>
            }
        </nav>

        <div class="sidebar-footer">
            @if (Session.IsAuthenticated)
            {
                <div class="user-pill">
                    <div class="user-pill-name">@Session.DisplayName</div>
                    <div class="user-pill-role">@Session.Role</div>
                </div>
            }

            <button type="button" class="btn btn-outlined btn-sm btn-block" @onclick="() => _confirmReset = true">
                <Icon Name="refresh" Size="15" /><span>@Loc.T("Nav_ResetDemo")</span>
            </button>

            <a class="btn btn-outlined btn-sm btn-block" href="https://github.com/felix-ngan/CAMAROESPOS" target="_blank" rel="noopener noreferrer">
                <Icon Name="external" Size="15" /><span>@Loc.T("Nav_Github")</span>
            </a>

            <button type="button" class="btn btn-danger btn-sm btn-block" @onclick="Logout">
                <Icon Name="logout" Size="15" /><span>@Loc.T("Nav_Logout")</span>
            </button>
        </div>
    </aside>

    <div class="main-area">
        <header class="topbar no-print">
            <div class="topbar-left">
                <button type="button"
                        class="btn btn-outlined btn-icon mobile-menu-btn"
                        aria-label="@Loc.T("Menu_Toggle")"
                        aria-expanded="@_mobileOpen"
                        @onclick="() => _mobileOpen = !_mobileOpen">
                    <Icon Name="menu" Size="20" />
                </button>
                <h1 class="topbar-title">@GetPageTitle()</h1>
            </div>

            <div class="topbar-actions">
                <button type="button"
                        class="btn btn-outlined btn-icon"
                        aria-label="@Loc.T("Theme_Toggle")"
                        title="@Loc.T("Theme_Toggle")"
                        @onclick="ToggleThemeAsync">
                    <Icon Name="@(_theme == "dark" ? "sun" : "moon")" Size="18" />
                </button>
                <button type="button"
                        class="btn btn-outlined btn-sm"
                        aria-label="@Loc.T("Lang_Toggle")"
                        title="@Loc.T("Lang_Toggle")"
                        @onclick="ToggleLangAsync">
                    @(Loc.CurrentLang == "fr" ? "EN" : "FR")
                </button>
                <span class="date-chip">
                    <Icon Name="clock" Size="15" />
                    <span>@Loc.T("Today") · @DateTime.Today.ToString("dd/MM/yyyy")</span>
                </span>
            </div>
        </header>

        @if (Storage.StorageQuotaExceeded)
        {
            <div class="alert alert-warning no-print" role="alert">
                <span>@Loc.T("Storage_QuotaWarning")</span>
            </div>
        }

        <main>
            @Body
        </main>
    </div>
</div>

<ConfirmModal IsOpen="_confirmReset"
              Title="@Loc.T("Nav_ResetDemo")"
              Message="Toutes vos modifications locales seront réinitialisées aux données de démonstration. Continuer ?"
              ConfirmText="@Loc.T("Btn_Confirm")"
              IsDanger="true"
              OnConfirm="ConfirmResetDemoAsync"
              OnCancel="() => _confirmReset = false" />

@code {
    private bool _mobileOpen;
    private bool _confirmReset;
    private string _theme = "light";

    protected override async Task OnInitializedAsync()
    {
        await Storage.LoadIntoAsync(Store);
        await Storage.RestoreSessionAsync(Session, Store);
        _theme = await Storage.LoadThemeAsync();
        var savedLang = await Storage.LoadLangAsync();
        if (!string.IsNullOrEmpty(savedLang)) Loc.SetLang(savedLang);

        Session.OnChange += StateHasChanged;
        Loc.OnChange += StateHasChanged;
        Storage.OnStorageWarning += StateHasChanged;
    }

    private string GetPageTitle()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/').ToLowerInvariant();
        return path switch
        {
            "" => Loc.T("Nav_Dashboard"),
            "pos" => Loc.T("Nav_POS"),
            "inventory" => Loc.T("Nav_Inventory"),
            "wallets" => Loc.T("Nav_Wallets"),
            "vendors" => Loc.T("Nav_Vendors"),
            "reports" => Loc.T("Nav_Reports"),
            "expenses" => Loc.T("Nav_Expenses"),
            "settings" => Loc.T("Nav_Settings"),
            _ => "CAMAROES POS"
        };
    }

    private async Task ToggleThemeAsync()
    {
        _theme = _theme == "dark" ? "light" : "dark";
        await Storage.SaveThemeAsync(_theme);
    }

    private async Task ToggleLangAsync()
    {
        Loc.Toggle();
        await Storage.SaveLangAsync(Loc.CurrentLang);
    }

    private async Task ConfirmResetDemoAsync(string _)
    {
        _confirmReset = false;
        await Storage.ResetAsync(Store);
        StateHasChanged();
    }

    private async Task Logout()
    {
        Session.Logout();
        await Storage.ClearSessionAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
        Loc.OnChange -= StateHasChanged;
        Storage.OnStorageWarning -= StateHasChanged;
    }
}
