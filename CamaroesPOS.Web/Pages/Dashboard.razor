@page "/"
@implements IDisposable
@inject PosStoreState Store
@inject LocalizationService Loc

<PageTitle>@Loc.T("Nav_Dashboard") — CAMAROES POS</PageTitle>

<RoleGuard RequireAdmin="true">
    <div class="stack">
        <!-- Top Actions & Coherent Global Period Filter -->
        <div class="row-between">
            <div class="row">
                <div class="pill-group" role="group" aria-label="Période d'analyse">
                    <button type="button" class="pill-btn @(_period == DashboardPeriod.Today ? "active" : "")" @onclick="() => SetPeriod(DashboardPeriod.Today)">@Loc.T("Dash_Period_Today")</button>
                    <button type="button" class="pill-btn @(_period == DashboardPeriod.Last7Days ? "active" : "")" @onclick="() => SetPeriod(DashboardPeriod.Last7Days)">@Loc.T("Dash_Period_7d")</button>
                    <button type="button" class="pill-btn @(_period == DashboardPeriod.Last30Days ? "active" : "")" @onclick="() => SetPeriod(DashboardPeriod.Last30Days)">@Loc.T("Dash_Period_30d")</button>
                    <button type="button" class="pill-btn @(_period == DashboardPeriod.AllTime ? "active" : "")" @onclick="() => SetPeriod(DashboardPeriod.AllTime)">@Loc.T("Dash_Period_All")</button>
                </div>
                @if (_m.LowStockItems > 0)
                {
                    <span class="badge badge-danger">
                        <Icon Name="alert" Size="13" />
                        <span>@_m.LowStockItems @Loc.T("Lbl_CriticalAlertCount")</span>
                    </span>
                }
            </div>
            <button type="button" class="btn btn-outlined btn-sm" @onclick="Refresh">
                <Icon Name="refresh" Size="15" /><span>@Loc.T("Refresh")</span>
            </button>
        </div>

        <!-- KPI Row 1 (All aligned to selected period!) -->
        <div class="grid-4">
            <div class="card">
                <span class="label-muted">@Loc.T("Dash_TodaySales")</span>
                <div class="kpi-value text-primary">@_m.PeriodSales.ToString("N0") @Store.Store.Currency</div>
                <div class="kpi-sub">@Loc.T("Today") : @_m.TodaySales.ToString("N0") · @Loc.T("Lbl_Cumulative") : @_m.TotalSalesAllTime.ToString("N0")</div>
            </div>
            <div class="card">
                <span class="label-muted">@Loc.T("Dash_NetProfit")</span>
                <div class="kpi-value @(_m.NetProfit >= 0m ? "text-success" : "text-danger")">@_m.NetProfit.ToString("N0") @Store.Store.Currency</div>
                <div class="kpi-sub">@Loc.T("Lbl_Expenses") : @_m.TotalExpenses.ToString("N0") @Store.Store.Currency</div>
            </div>
            <div class="card">
                <span class="label-muted">@Loc.T("Dash_StockVolume")</span>
                <div class="kpi-value">@_m.TotalStockQuantity.ToString("N0") @Loc.T("Lbl_Units")</div>
                <div class="kpi-sub">@_m.TotalProducts @Loc.T("Lbl_References")</div>
            </div>
            <div class="card">
                <span class="label-muted">@Loc.T("Dash_CriticalAlerts")</span>
                <div class="kpi-value text-danger">@_m.LowStockItems</div>
                <div class="kpi-sub">@Loc.T("Nav_Wallets") : @_m.TotalCustomers</div>
            </div>
        </div>

        <!-- KPI Row 2 -->
        <div class="grid-4">
            <div class="card">
                <span class="label-muted">@Loc.T("Dash_ItemsSold")</span>
                <div class="kpi-value">@_m.PeriodItemsSold</div>
                <div class="kpi-sub">@Loc.T("Today") : @_m.TotalItemsSoldToday · @Loc.T("Lbl_Cumulative") : @_m.TotalItemsSoldAllTime</div>
            </div>
            <div class="card">
                <span class="label-muted">@Loc.T("Dash_Wallets")</span>
                <div class="kpi-value" style="color:#0D9488;">@_m.TotalWalletsBalance.ToString("N0") @Store.Store.Currency</div>
                <div class="kpi-sub">@Loc.T("Wallet_Points") : @_m.TotalLoyaltyPoints.ToString("N0")</div>
            </div>
            <div class="card">
                <span class="label-muted">@Loc.T("Dash_Discounts")</span>
                <div class="kpi-value text-warning">@_m.TotalDiscountAmount.ToString("N0") @Store.Store.Currency</div>
                <div class="kpi-sub">@Loc.T("POS_Vat") : @_m.TotalTaxCollected.ToString("N0") · @Loc.T("Lbl_Cancellations") : @_m.TotalCancelledAmount.ToString("N0")</div>
            </div>
            <div class="card">
                <span class="label-muted">@Loc.T("Dash_Users")</span>
                <div class="kpi-value">@_m.TotalUsers</div>
                <div class="kpi-sub">Admin : @_m.AdminCount | @Loc.T("Lbl_Cashiers") : @_m.CashierCount</div>
            </div>
        </div>

        <!-- Charts Row 1 -->
        <div class="grid-2-1">
            <div class="card">
                <h2 class="card-title">@Loc.T("Dash_ChartRevenue7d")</h2>
                <LineChartSvg Labels="@_m.Last7DaysLabels" Values="@_m.Last7DaysSales" PrimaryLabel="@($"{Loc.T("Lbl_Revenue")} ({Store.Store.Currency})")" />
            </div>
            <div class="card">
                <h2 class="card-title">@Loc.T("Dash_ChartPayments")</h2>
                <PieChartSvg Items="@_m.PaymentModes" />
            </div>
        </div>

        <!-- Charts Row 2 -->
        <div class="grid-2">
            <div class="card">
                <h2 class="card-title">@Loc.T("Dash_ChartStock7d")</h2>
                <LineChartSvg Labels="@_m.Last7DaysLabels"
                              Values="@_m.Last7DaysStockIn"
                              SecondaryValues="@_m.Last7DaysStockOut"
                              StrokeColor="#15803D"
                              FillColor="rgba(21, 128, 61, 0.12)"
                              SecondaryStrokeColor="#DC2626"
                              PrimaryLabel="@Loc.T("Lbl_StockIn")"
                              SecondaryLabel="@Loc.T("Lbl_StockOut")" />
            </div>
            <div class="card">
                <h2 class="card-title">@Loc.T("Dash_ChartProfit")</h2>
                <BarChartSvg Items="@ProfitItems" Colors="@(new[] { "#1D72E8", "#D97706", "#DC2626", "#15803D" })" />
            </div>
        </div>

        <!-- Charts Row 3 -->
        <div class="grid-2">
            <div class="card">
                <h2 class="card-title">@Loc.T("Dash_ChartTopStock")</h2>
                <BarChartSvg Items="@_m.TopProductsStock" />
            </div>
            <div class="card">
                <h2 class="card-title">@Loc.T("Dash_ChartTopCustomers")</h2>
                <BarChartSvg Items="@_m.TopCustomers" Colors="@(new[] { "#0D9488", "#1D72E8", "#7E57C2", "#D97706", "#15803D" })" />
            </div>
        </div>

        <div class="grid-2-1">
            <div class="card">
                <h2 class="card-title">@Loc.T("Dash_ChartTopSold")</h2>
                <BarChartSvg Items="@_m.TopSoldItems" />
            </div>
            <div class="card">
                <h2 class="card-title">@Loc.T("Dash_ChartRoles")</h2>
                <PieChartSvg Items="@_m.UsersByRole" />
            </div>
        </div>

        <!-- Tables Row -->
        <div class="grid-2">
            <div class="card">
                <h2 class="card-title">@Loc.T("Dash_CriticalAlerts")</h2>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("Col_Code")</th>
                                <th>@Loc.T("Col_Description")</th>
                                <th class="text-right">Stock</th>
                                <th class="text-right">@Loc.T("Inv_Reorder")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _m.CriticalStockList)
                            {
                                <tr>
                                    <td><strong>@p.ProductCode</strong></td>
                                    <td>@p.Description</td>
                                    <td class="text-right"><span class="badge badge-danger">@p.Qty</span></td>
                                    <td class="text-right">@p.Reorder</td>
                                </tr>
                            }
                            @if (_m.CriticalStockList.Count == 0)
                            {
                                <tr><td colspan="4" style="text-align:center;color:var(--muted);">@Loc.T("Lbl_NoCriticalAlert")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="row-between" style="margin-bottom:10px;">
                    <h2 class="card-title" style="margin-bottom:0;">@Loc.T("Dash_UsersList")</h2>
                    <input class="input input-inline"
                           style="min-width:220px;"
                           aria-label="@Loc.T("Dash_SearchUser")"
                           @bind="_userSearch"
                           @bind:event="oninput"
                           placeholder="@Loc.T("Dash_SearchUser")" />
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("Login_Username")</th>
                                <th>@Loc.T("Col_Name")</th>
                                <th>@Loc.T("Col_Role")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in FilteredUsers)
                            {
                                <tr>
                                    <td><strong>@u.Username</strong></td>
                                    <td>@u.Name</td>
                                    <td><span class="badge @(u.Role == "Admin" ? "badge-info" : "badge-success")">@u.Role</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</RoleGuard>

@code {
    private DashboardPeriod _period = DashboardPeriod.Last7Days;
    private DashboardMetrics _m = new();
    private string _userSearch = string.Empty;

    private List<(string Label, double Value)> ProfitItems => new()
    {
        (Loc.T("Lbl_Revenue"), (double)_m.PeriodSales),
        (Loc.T("Lbl_Costs"), (double)_m.TotalCOGS),
        (Loc.T("Lbl_Expenses"), (double)_m.TotalExpenses),
        (Loc.T("Lbl_Profit"), (double)Math.Max(0m, _m.NetProfit))
    };

    private IEnumerable<User> FilteredUsers => string.IsNullOrWhiteSpace(_userSearch)
        ? Store.Users
        : Store.Users.Where(u =>
            (u.Username?.Contains(_userSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (u.Name?.Contains(_userSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (u.Role?.Contains(_userSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override void OnInitialized()
    {
        Refresh();
        Store.OnChanged += Refresh;
        Loc.OnChange += StateHasChanged;
    }

    private void SetPeriod(DashboardPeriod p)
    {
        _period = p;
        Refresh();
    }

    private void Refresh()
    {
        _m = Store.GetDashboardMetrics(_period);
        StateHasChanged();
    }

    public void Dispose()
    {
        Store.OnChanged -= Refresh;
        Loc.OnChange -= StateHasChanged;
    }
}
