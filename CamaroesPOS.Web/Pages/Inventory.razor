@page "/inventory"
@implements IDisposable
@inject PosStoreState Store
@inject BrowserStorageService Storage
@inject SessionState Session
@inject LocalizationService Loc

<PageTitle>@Loc.T("Nav_Inventory") — CAMAROES POS</PageTitle>

<RoleGuard>
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert @(_err ? "alert-error" : "alert-success")" role="alert">
            <span>@_msg</span>
            <button type="button" class="btn btn-icon btn-sm" aria-label="@Loc.T("Btn_Close")" @onclick="() => _msg = string.Empty">
                <Icon Name="x" Size="16" />
            </button>
        </div>
    }

    <div class="@(_isEditing || _isAdjusting ? "grid-split" : "")">
        <div class="card stack">
            <div class="row-between">
                <input class="input" style="flex:1;min-width:200px;" aria-label="@Loc.T("Inv_Search")" @bind="_search" @bind:event="oninput" placeholder="@Loc.T("Inv_Search")" />
                <div class="row">
                    <button type="button" class="btn btn-outlined btn-sm" @onclick="ExportCsvAsync">
                        <Icon Name="download" Size="15" /><span>CSV</span>
                    </button>
                    @if (Session.IsAdmin)
                    {
                        <button type="button" class="btn btn-outlined btn-sm" @onclick="() => _showBrandCat = true">
                            <Icon Name="tag" Size="15" /><span>@Loc.T("Inv_BrandsCategories")</span>
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="OpenAdd">
                            <Icon Name="plus" Size="15" /><span>@Loc.T("Inv_AddProduct")</span>
                        </button>
                    }
                </div>
            </div>

            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@Loc.T("Col_Code")</th>
                            <th>@Loc.T("Col_Barcode")</th>
                            <th>@Loc.T("Col_Description")</th>
                            <th>@Loc.T("Col_Brand")</th>
                            <th>@Loc.T("Col_Category")</th>
                            <th>@Loc.T("Col_Vendor")</th>
                            <th class="text-right">@Loc.T("Inv_SalePrice")</th>
                            <th class="text-right">Stock</th>
                            @if (Session.IsAdmin)
                            {
                                <th>@Loc.T("Col_Actions")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in FilteredProducts)
                        {
                            <tr>
                                <td><strong>@p.ProductCode</strong></td>
                                <td>@p.Barcode</td>
                                <td>@p.Description</td>
                                <td>@p.BrandName</td>
                                <td>@p.CategoryName</td>
                                <td>@p.VendorName</td>
                                <td class="text-right">@p.Price.ToString("N0")</td>
                                <td class="text-right">
                                    <span class="badge @(p.Qty <= p.Reorder ? "badge-danger" : "badge-success")">@p.Qty</span>
                                </td>
                                @if (Session.IsAdmin)
                                {
                                    <td class="actions-cell">
                                        <div class="row-nowrap">
                                            <button type="button" class="btn btn-outlined btn-icon" aria-label="@($"Ajuster stock {p.Description}")" title="@Loc.T("Inv_AdjustStock")" @onclick="() => OpenAdjust(p)">
                                                <Icon Name="adjust" Size="15" />
                                            </button>
                                            <button type="button" class="btn btn-outlined btn-icon" aria-label="@($"Modifier {p.Description}")" title="Modifier" @onclick="() => OpenEdit(p)">
                                                <Icon Name="edit" Size="15" />
                                            </button>
                                            <button type="button" class="btn btn-danger btn-icon" aria-label="@($"Supprimer {p.Description}")" title="@Loc.T("Btn_Delete")" @onclick="() => _deleteTarget = p">
                                                <Icon Name="trash" Size="15" />
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_isEditing && _editModel != null && Session.IsAdmin)
        {
            <form class="card stack" @onsubmit="SaveProductAsync" @onsubmit:preventDefault="true">
                <h2 class="card-title" style="margin:0;">@Loc.T("Inv_ProductSheet")</h2>

                <div>
                    <label class="label-muted" for="inv-code">@Loc.T("Col_Code")</label>
                    <input id="inv-code" class="input" @bind="_editModel.ProductCode" disabled="@(!_isNew)" required />
                </div>
                <div>
                    <label class="label-muted" for="inv-bc">@Loc.T("Col_Barcode")</label>
                    <input id="inv-bc" class="input" @bind="_editModel.Barcode" />
                </div>
                <div>
                    <label class="label-muted" for="inv-desc">@Loc.T("Col_Description")</label>
                    <input id="inv-desc" class="input" @bind="_editModel.Description" required />
                </div>
                <div>
                    <label class="label-muted" for="inv-brand">@Loc.T("Col_Brand")</label>
                    <select id="inv-brand" class="input" @bind="_editModel.BrandName">
                        <option value="">—</option>
                        @foreach (var b in Store.Brands)
                        {
                            <option value="@b.BrandName">@b.BrandName</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="label-muted" for="inv-cat">@Loc.T("Col_Category")</label>
                    <select id="inv-cat" class="input" @bind="_editModel.CategoryName">
                        <option value="">—</option>
                        @foreach (var c in Store.Categories)
                        {
                            <option value="@c.CategoryName">@c.CategoryName</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="label-muted" for="inv-vendor">@Loc.T("Col_Vendor")</label>
                    <select id="inv-vendor" class="input" @bind="_editModel.VendorId">
                        <option value="0">—</option>
                        @foreach (var v in Store.Vendors)
                        {
                            <option value="@v.Id">@v.VendorName</option>
                        }
                    </select>
                </div>
                <div class="grid-2">
                    <div>
                        <label class="label-muted" for="inv-price">@Loc.T("Inv_SalePrice")</label>
                        <input id="inv-price" class="input tabular" type="number" min="0" @bind="_editModel.Price" />
                    </div>
                    <div>
                        <label class="label-muted" for="inv-cost">@Loc.T("Inv_CostPrice")</label>
                        <input id="inv-cost" class="input tabular" type="number" min="0" @bind="_editModel.CostPrice" />
                    </div>
                </div>
                <div class="grid-2">
                    <div>
                        <label class="label-muted" for="inv-qty">@Loc.T("Inv_CurrentStock")</label>
                        <input id="inv-qty" class="input tabular" type="number" min="0" @bind="_editModel.Qty" />
                    </div>
                    <div>
                        <label class="label-muted" for="inv-reorder">@Loc.T("Inv_Reorder")</label>
                        <input id="inv-reorder" class="input tabular" type="number" min="0" @bind="_editModel.Reorder" />
                    </div>
                </div>
                <label class="row" style="cursor:pointer;">
                    <input type="checkbox" @bind="_editModel.IsTaxable" />
                    <span>@Loc.T("Inv_Taxable") (@Store.Store.TaxRate.ToString("0.##")%)</span>
                </label>
                <div class="grid-2">
                    <button type="button" class="btn btn-outlined" @onclick="() => _isEditing = false">@Loc.T("Btn_Cancel")</button>
                    <button type="submit" class="btn btn-primary">@Loc.T("Btn_Save")</button>
                </div>
            </form>
        }

        @if (_isAdjusting && _adjustTarget != null && Session.IsAdmin)
        {
            <form class="card stack" @onsubmit="SaveAdjustmentAsync" @onsubmit:preventDefault="true">
                <h2 class="card-title" style="margin:0;">@Loc.T("Inv_AdjustStock")</h2>
                <div style="font-weight:700;color:var(--primary);">@_adjustTarget.Description</div>
                <div class="label-muted">@Loc.T("Inv_CurrentStock") : @_adjustTarget.Qty</div>

                <div>
                    <label class="label-muted" for="adj-type">@Loc.T("Inv_OpType")</label>
                    <select id="adj-type" class="input" @bind="_adjType">
                        <option value="Entrée">Entrée</option>
                        <option value="Sortie">Sortie</option>
                        <option value="Ajustement (Inventaire)">Ajustement (Inventaire)</option>
                    </select>
                </div>
                <div>
                    <label class="label-muted" for="adj-qty">@Loc.T("Col_Qty")</label>
                    <input id="adj-qty" class="input tabular" type="number" min="0" @bind="_adjQty" />
                </div>
                <div>
                    <label class="label-muted" for="adj-reason">@Loc.T("Inv_Justification")</label>
                    <textarea id="adj-reason" class="input" rows="3" @bind="_adjReason" required></textarea>
                </div>
                <div class="grid-2">
                    <button type="button" class="btn btn-outlined" @onclick="() => _isAdjusting = false">@Loc.T("Btn_Cancel")</button>
                    <button type="submit" class="btn btn-success">@Loc.T("Btn_Confirm")</button>
                </div>
            </form>
        }
    </div>

    <BrandCategoryModal IsOpen="_showBrandCat" OnClose="() => _showBrandCat = false" />

    <ConfirmModal IsOpen="@(_deleteTarget != null)"
                  Title="@Loc.T("Confirm_DeleteTitle")"
                  Message="@(_deleteTarget == null ? "" : $"Supprimer définitivement le produit « {_deleteTarget.Description} » ({_deleteTarget.ProductCode}) ?")"
                  ConfirmText="@Loc.T("Btn_Delete")"
                  IsDanger="true"
                  OnConfirm="ConfirmDeleteProductAsync"
                  OnCancel="() => _deleteTarget = null" />
</RoleGuard>

@code {
    private string _search = string.Empty;
    private bool _isEditing;
    private bool _isNew;
    private Product? _editModel;
    private Product? _deleteTarget;

    private bool _isAdjusting;
    private Product? _adjustTarget;
    private string _adjType = "Entrée";
    private int _adjQty;
    private string _adjReason = string.Empty;

    private bool _showBrandCat;
    private string _msg = string.Empty;
    private bool _err;

    private IEnumerable<Product> FilteredProducts => string.IsNullOrWhiteSpace(_search)
        ? Store.Products
        : Store.Products.Where(p =>
            (p.ProductCode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Barcode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.BrandName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.CategoryName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override void OnInitialized()
    {
        Store.OnChanged += StateHasChanged;
        Loc.OnChange += StateHasChanged;
    }

    private void OpenAdd()
    {
        if (!Session.IsAdmin) return;
        _editModel = new Product { ProductCode = "", Barcode = "", Description = "", BrandName = "", CategoryName = "", VendorName = "", Reorder = 5, IsTaxable = true };
        _isNew = true; _isEditing = true; _isAdjusting = false;
    }

    private void OpenEdit(Product p)
    {
        if (!Session.IsAdmin) return;
        _editModel = new Product
        {
            ProductCode = p.ProductCode, Barcode = p.Barcode, Description = p.Description,
            BrandName = p.BrandName, CategoryName = p.CategoryName, VendorId = p.VendorId, VendorName = p.VendorName,
            CostPrice = p.CostPrice, Price = p.Price, Qty = p.Qty, Reorder = p.Reorder, IsTaxable = p.IsTaxable
        };
        _isNew = false; _isEditing = true; _isAdjusting = false;
    }

    private async Task SaveProductAsync()
    {
        if (_editModel == null) return;
        var res = Store.SaveProduct(_editModel, _isNew, Session.IsAdmin, Session.DisplayName);
        _msg = res.Message; _err = !res.Success;
        if (res.Success) { _isEditing = false; await Storage.PersistAsync(Store); }
    }

    private async Task ConfirmDeleteProductAsync(string _)
    {
        if (_deleteTarget == null) return;
        var res = Store.DeleteProduct(_deleteTarget.ProductCode, Session.IsAdmin, Session.DisplayName);
        _deleteTarget = null;
        _msg = res.Message; _err = !res.Success;
        if (res.Success) await Storage.PersistAsync(Store);
    }

    private void OpenAdjust(Product p)
    {
        if (!Session.IsAdmin) return;
        _adjustTarget = p; _adjType = "Entrée"; _adjQty = 0; _adjReason = string.Empty;
        _isAdjusting = true; _isEditing = false;
    }

    private async Task SaveAdjustmentAsync()
    {
        if (_adjustTarget == null) return;
        var res = Store.AdjustStock(_adjustTarget.ProductCode, _adjType, _adjQty, _adjReason, Session.CurrentUser?.Username ?? "admin", Session.IsAdmin);
        _msg = res.Message; _err = !res.Success;
        if (res.Success) { _isAdjusting = false; await Storage.PersistAsync(Store); }
    }

    private Task ExportCsvAsync()
        => Storage.DownloadFileAsync($"camaroes_stock_{DateTime.Now:yyyyMMdd}.csv", PosStoreState.ExportInventoryCsv(FilteredProducts), "text/csv;charset=utf-8");

    public void Dispose()
    {
        Store.OnChanged -= StateHasChanged;
        Loc.OnChange -= StateHasChanged;
    }
}
