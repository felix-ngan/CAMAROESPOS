@page "/reports"
@implements IDisposable
@inject PosStoreState Store
@inject BrowserStorageService Storage
@inject SessionState Session
@inject LocalizationService Loc

<PageTitle>@Loc.T("Nav_Reports") — CAMAROES POS</PageTitle>

<RoleGuard>
    <div class="stack">
        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="alert @(_err ? "alert-error" : "alert-success") no-print" role="alert">
                <span>@_msg</span>
                <button type="button" class="btn btn-icon btn-sm" aria-label="@Loc.T("Btn_Close")" @onclick="() => _msg = string.Empty">
                    <Icon Name="x" Size="16" />
                </button>
            </div>
        }

        <!-- Filters -->
        <div class="card no-print">
            <div class="row">
                <div>
                    <label class="label-muted" for="rep-start">@Loc.T("Rep_StartDate")</label>
                    <input id="rep-start" class="input input-inline" type="date" @bind="_startDate" />
                </div>
                <div>
                    <label class="label-muted" for="rep-end">@Loc.T("Rep_EndDate")</label>
                    <input id="rep-end" class="input input-inline" type="date" @bind="_endDate" />
                </div>
                <div style="flex:1;min-width:190px;">
                    <label class="label-muted" for="rep-search">@Loc.T("Rep_Search")</label>
                    <input id="rep-search" class="input" @bind="_search" @bind:event="oninput" placeholder="@Loc.T("Rep_Search")" />
                </div>
                <div class="row" style="align-self:flex-end;">
                    <button type="button" class="btn btn-outlined btn-sm" @onclick="ResetFilters">@Loc.T("Rep_Reset")</button>
                    <button type="button" class="btn btn-outlined btn-sm" @onclick="ExportCsvAsync">
                        <Icon Name="download" Size="15" /><span>@Loc.T("Rep_ExportCsv")</span>
                    </button>
                    <button type="button" class="btn btn-success btn-sm" @onclick="PrintReportAsync">
                        <Icon Name="printer" Size="15" /><span>@Loc.T("Rep_ExportPdf")</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Summary KPIs -->
        @{
            var activeTickets = FilteredTickets.Where(t => t.Status != "Refunded").ToList();
        }
        <div class="grid-3">
            <div class="card">
                <span class="label-muted">@Loc.T("Lbl_Revenue") (TTC)</span>
                <div class="kpi-value text-primary">@activeTickets.Sum(t => t.TotalTTC).ToString("N0") @Store.Store.Currency</div>
                <div class="kpi-sub">@activeTickets.Count @Loc.T("Lbl_SalesLines") · HT : @activeTickets.Sum(t => t.SubTotalHT).ToString("N0")</div>
            </div>
            <div class="card">
                <span class="label-muted">@Loc.T("Dash_ItemsSold")</span>
                <div class="kpi-value">@activeTickets.Sum(t => t.TotalQty)</div>
                <div class="kpi-sub">@Loc.T("Lbl_Discounts") : @activeTickets.Sum(t => t.Discount).ToString("N0") @Store.Store.Currency</div>
            </div>
            <div class="card">
                <span class="label-muted">@Loc.T("POS_Vat") (@Store.Store.TaxRate.ToString("0.##")%)</span>
                <div class="kpi-value text-success">@activeTickets.Sum(t => t.TaxAmount).ToString("N0") @Store.Store.Currency</div>
                <div class="kpi-sub">@Loc.T("Lbl_Cancellations") : @FilteredCancelled.Sum(c => c.Total).ToString("N0") @Store.Store.Currency</div>
            </div>
        </div>

        <!-- 7 Tabs: Grouped Tickets, Stock, Stock History, Refunds, Wallets, Z-Reports, Audit Log -->
        <div class="card">
            <div class="tabs no-print" role="tablist">
                <button type="button" class="tab-btn @(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">@Loc.T("Rep_TabSales")</button>
                <button type="button" class="tab-btn @(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">@Loc.T("Rep_TabStock")</button>
                <button type="button" class="tab-btn @(_tab == 2 ? "active" : "")" @onclick="() => _tab = 2">@Loc.T("Rep_TabHistory")</button>
                <button type="button" class="tab-btn @(_tab == 3 ? "active" : "")" @onclick="() => _tab = 3">@Loc.T("Rep_TabCancelled")</button>
                <button type="button" class="tab-btn @(_tab == 4 ? "active" : "")" @onclick="() => _tab = 4">@Loc.T("Rep_TabWallets")</button>
                <button type="button" class="tab-btn @(_tab == 5 ? "active" : "")" @onclick="() => _tab = 5">@Loc.T("Rep_TabShifts")</button>
                @if (Session.IsAdmin)
                {
                    <button type="button" class="tab-btn @(_tab == 6 ? "active" : "")" @onclick="() => _tab = 6">@Loc.T("Rep_TabAudit")</button>
                }
            </div>

            @if (_tab == 0)
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("Col_Date")</th>
                                <th>@Loc.T("Lbl_TransNo")</th>
                                <th>@Loc.T("Col_Description")</th>
                                <th class="text-right">@Loc.T("Col_Qty")</th>
                                <th class="text-right">@Loc.T("Col_Total")</th>
                                <th>@Loc.T("Col_Cashier")</th>
                                <th>Mode</th>
                                <th>@Loc.T("Col_Status")</th>
                                <th class="no-print">@Loc.T("Col_Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in FilteredTickets)
                            {
                                bool refunded = t.Status == "Refunded";
                                <tr>
                                    <td>@t.SoldDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><strong>@t.TransNo</strong></td>
                                    <td>
                                        @string.Join(", ", t.Lines.Select(l => $"{l.Description} (×{l.Qty})"))
                                        @if (!string.IsNullOrWhiteSpace(t.PaymentReference))
                                        {
                                            <div class="kpi-sub">@t.PaymentReference</div>
                                        }
                                    </td>
                                    <td class="text-right">@t.TotalQty</td>
                                    <td class="text-right"><strong>@t.TotalTTC.ToString("N0")</strong></td>
                                    <td>@t.Cashier</td>
                                    <td><span class="badge badge-info">@t.PaymentMode</span></td>
                                    <td>
                                        <span class="badge @(refunded ? "badge-danger" : "badge-success")">
                                            @(refunded ? Loc.T("Status_Refunded") : Loc.T("Status_Completed"))
                                        </span>
                                    </td>
                                    <td class="actions-cell no-print">
                                        <div class="row-nowrap">
                                            <button type="button" class="btn btn-outlined btn-icon" aria-label="@Loc.T("Rep_ViewReceipt")" title="@Loc.T("Rep_ViewReceipt")" @onclick="() => OpenTicketReceipt(t)">
                                                <Icon Name="printer" Size="15" />
                                            </button>
                                            @if (Session.IsAdmin && !refunded)
                                            {
                                                <button type="button" class="btn btn-danger btn-icon" aria-label="@Loc.T("Rep_Refund")" title="@Loc.T("Rep_Refund")" @onclick="() => _refundTarget = t">
                                                    <Icon Name="undo" Size="15" />
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_tab == 1)
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("Col_Code")</th>
                                <th>@Loc.T("Col_Description")</th>
                                <th>@Loc.T("Col_Brand")</th>
                                <th>@Loc.T("Col_Category")</th>
                                <th>@Loc.T("Col_Vendor")</th>
                                <th class="text-right">@Loc.T("Col_Price")</th>
                                <th class="text-right">Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in FilteredProducts)
                            {
                                <tr>
                                    <td><strong>@p.ProductCode</strong></td>
                                    <td>@p.Description</td>
                                    <td>@p.BrandName</td>
                                    <td>@p.CategoryName</td>
                                    <td>@p.VendorName</td>
                                    <td class="text-right">@p.Price.ToString("N0")</td>
                                    <td class="text-right"><span class="badge @(p.Qty <= p.Reorder ? "badge-danger" : "badge-success")">@p.Qty</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_tab == 2)
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("Col_Date")</th>
                                <th>@Loc.T("Lbl_Ref")</th>
                                <th>@Loc.T("Col_Description")</th>
                                <th>@Loc.T("Col_Vendor")</th>
                                <th class="text-right">@Loc.T("Col_Qty")</th>
                                <th>@Loc.T("Lbl_By")</th>
                                <th>@Loc.T("Lbl_Reason")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var st in FilteredStocks)
                            {
                                <tr>
                                    <td>@st.StockInDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@st.RefNo</td>
                                    <td>@st.Description</td>
                                    <td>@st.VendorName</td>
                                    <td class="text-right"><strong>@st.Qty</strong></td>
                                    <td>@st.StockInBy</td>
                                    <td>@st.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_tab == 3)
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("Col_Date")</th>
                                <th>@Loc.T("Lbl_TransNo")</th>
                                <th>@Loc.T("Col_Description")</th>
                                <th class="text-right">@Loc.T("Col_Total")</th>
                                <th>@Loc.T("Lbl_CancelledBy")</th>
                                <th>@Loc.T("Lbl_Reason")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in FilteredCancelled)
                            {
                                <tr>
                                    <td>@c.SoldDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@c.TransNo</td>
                                    <td>
                                        @c.Description
                                        @if (c.WalletRefunded)
                                        {
                                            <span class="badge badge-success" style="margin-left:6px;">Wallet recrédité</span>
                                        }
                                    </td>
                                    <td class="text-right text-danger">@c.Total.ToString("N0")</td>
                                    <td>@c.CancelledBy</td>
                                    <td>@c.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_tab == 4)
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("Col_Date")</th>
                                <th>@Loc.T("Lbl_TransNo")</th>
                                <th>@Loc.T("Col_Phone")</th>
                                <th>Type</th>
                                <th class="text-right">@Loc.T("Col_Amount")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var wt in FilteredWallets)
                            {
                                string badge = wt.Type == "Credit" ? "badge-success" : wt.Type == "Refund" ? "badge-info" : "badge-warning";
                                <tr>
                                    <td>@wt.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@wt.TransNo</td>
                                    <td>@wt.Phone</td>
                                    <td><span class="badge @badge">@wt.Type</span></td>
                                    <td class="text-right"><strong>@wt.Amount.ToString("N0") @Store.Store.Currency</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_tab == 5)
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ouverture</th>
                                <th>Clôture</th>
                                <th class="text-right">Fond initial</th>
                                <th class="text-right">Ventes Total</th>
                                <th class="text-right">Attendu Esp.</th>
                                <th class="text-right">Compté</th>
                                <th class="text-right">Écart</th>
                                <th>@Loc.T("Col_Status")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sh in Store.CashShifts.OrderByDescending(x => x.OpenedAt))
                            {
                                <tr>
                                    <td><strong>#@sh.Id</strong></td>
                                    <td>@sh.OpenedAt.ToString("dd/MM HH:mm")<div class="kpi-sub">@sh.OpenedBy</div></td>
                                    <td>@(sh.ClosedAt?.ToString("dd/MM HH:mm") ?? "—")<div class="kpi-sub">@(sh.ClosedBy ?? "")</div></td>
                                    <td class="text-right">@sh.OpeningFloat.ToString("N0")</td>
                                    <td class="text-right"><strong>@sh.TotalSales.ToString("N0")</strong></td>
                                    <td class="text-right">@sh.ExpectedCash.ToString("N0")</td>
                                    <td class="text-right">@(sh.CountedCash?.ToString("N0") ?? "—")</td>
                                    <td class="text-right @(sh.Discrepancy is < 0m ? "text-danger" : "text-success")">@(sh.Discrepancy?.ToString("+#,##0;-#,##0;0") ?? "—")</td>
                                    <td><span class="badge @(sh.IsOpen ? "badge-success" : "badge-info")">@(sh.IsOpen ? "Ouverte" : "Clôturée")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_tab == 6 && Session.IsAdmin)
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("Col_Date")</th>
                                <th>Acteur</th>
                                <th>Action</th>
                                <th>Cible</th>
                                <th>Détails</th>
                                <th>Niveau</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Store.AuditLogs.OrderByDescending(x => x.Timestamp).Take(100))
                            {
                                string sevBadge = a.Severity == "Critical" ? "badge-danger" : a.Severity == "Warning" ? "badge-warning" : "badge-info";
                                <tr>
                                    <td>@a.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td><strong>@a.Actor</strong> <span class="kpi-sub">(@a.Role)</span></td>
                                    <td><code>@a.Action</code></td>
                                    <td>@a.Target</td>
                                    <td>@a.Details</td>
                                    <td><span class="badge @sevBadge">@a.Severity</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <ConfirmModal IsOpen="@(_refundTarget != null)"
                  Title="@Loc.T("Rep_RefundTitle")"
                  Message="@(_refundTarget == null ? "" : $"Rembourser le ticket {_refundTarget.TransNo} ({_refundTarget.TotalTTC:N0} {Store.Store.Currency}) ? Le stock sera restauré et le portefeuille client sera recrédité le cas échéant.")"
                  ConfirmText="@Loc.T("Rep_Refund")"
                  IsDanger="true"
                  ShowReasonInput="true"
                  RequireReason="true"
                  ReasonLabel="@Loc.T("Rep_RefundReason")"
                  OnConfirm="ConfirmRefundAsync"
                  OnCancel="() => _refundTarget = null" />

    <ReceiptModal Result="_previewReceipt"
                  Items="_previewItems"
                  Cashier="@_previewCashier"
                  CustomerPhone="@_previewPhone"
                  OnClose="() => _previewReceipt = null" />
</RoleGuard>

@code {
    private DateTime? _startDate = DateTime.Today.AddDays(-30);
    private DateTime? _endDate = DateTime.Today;
    private string _search = string.Empty;
    private int _tab;
    private string _msg = string.Empty;
    private bool _err;

    private SalesTicketSummary? _refundTarget;
    private CheckoutResult? _previewReceipt;
    private List<CartItem> _previewItems = new();
    private string _previewCashier = string.Empty;
    private string _previewPhone = string.Empty;

    private bool InRange(DateTime d)
        => (!_startDate.HasValue || d >= _startDate.Value.Date) &&
           (!_endDate.HasValue || d < _endDate.Value.Date.AddDays(1));

    private bool Match(params string?[] fields)
        => string.IsNullOrWhiteSpace(_search) ||
           fields.Any(f => f != null && f.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private List<SalesTicketSummary> FilteredTickets => Store.GetGroupedSalesTickets(_startDate, _endDate, _search);

    private IEnumerable<Product> FilteredProducts => Store.Products
        .Where(p => Match(p.ProductCode, p.Description, p.BrandName, p.CategoryName, p.VendorName))
        .OrderBy(p => p.Description);

    private IEnumerable<Stock> FilteredStocks => Store.Stocks
        .Where(s => InRange(s.StockInDate) && Match(s.RefNo, s.ProductCode, s.Description, s.VendorName, s.Status))
        .OrderByDescending(s => s.StockInDate);

    private IEnumerable<CancelledOrder> FilteredCancelled => Store.CancelledOrders
        .Where(c => InRange(c.SoldDate) && Match(c.TransNo, c.ProductCode, c.Description, c.CancelledBy))
        .OrderByDescending(c => c.SoldDate);

    private IEnumerable<WalletTransaction> FilteredWallets => Store.WalletTransactions
        .Where(w => InRange(w.CreatedAt) && Match(w.TransNo, w.Phone, w.Type))
        .OrderByDescending(w => w.CreatedAt);

    protected override void OnInitialized()
    {
        Store.OnChanged += StateHasChanged;
        Loc.OnChange += StateHasChanged;
    }

    private void ResetFilters()
    {
        _startDate = DateTime.Today.AddDays(-30);
        _endDate = DateTime.Today;
        _search = string.Empty;
    }

    private void OpenTicketReceipt(SalesTicketSummary t)
    {
        _previewItems = t.Lines.Select(l => new CartItem
        {
            ProductCode = l.ProductCode,
            ProductDescription = l.Description,
            Price = l.Price,
            Qty = l.Qty,
            Total = l.Price * l.Qty
        }).ToList();
        _previewCashier = t.Cashier;
        _previewPhone = t.CustomerPhone;
        _previewReceipt = new CheckoutResult(
            true,
            "",
            t.TransNo,
            t.SoldDate,
            t.SubTotalHT,
            t.TaxAmount,
            Store.Store.TaxRate,
            t.TotalTTC + t.Discount,
            t.Discount,
            t.TotalTTC,
            t.TotalTTC,
            0m,
            t.PaymentMode,
            t.PaymentReference);
    }

    private async Task ConfirmRefundAsync(string reason)
    {
        if (_refundTarget == null) return;
        var res = Store.RefundTransaction(_refundTarget.TransNo, Session.DisplayName, Session.IsAdmin, reason);
        _refundTarget = null;
        _msg = res.Message; _err = !res.Success;
        if (res.Success) await Storage.PersistAsync(Store);
    }

    private async Task ExportCsvAsync()
    {
        if (_tab == 1)
        {
            var csv = PosStoreState.ExportInventoryCsv(FilteredProducts);
            await Storage.DownloadFileAsync($"camaroes_stock_{DateTime.Now:yyyyMMdd}.csv", csv, "text/csv;charset=utf-8");
        }
        else
        {
            var lines = FilteredTickets.SelectMany(t => t.Lines);
            var csv = PosStoreState.ExportSalesCsv(lines);
            await Storage.DownloadFileAsync($"camaroes_ventes_{DateTime.Now:yyyyMMdd}.csv", csv, "text/csv;charset=utf-8");
        }
    }

    private Task PrintReportAsync() => Storage.PrintAsync();

    public void Dispose()
    {
        Store.OnChanged -= StateHasChanged;
        Loc.OnChange -= StateHasChanged;
    }
}
