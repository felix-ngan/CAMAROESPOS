@page "/vendors"
@implements IDisposable
@inject PosStoreState Store
@inject BrowserStorageService Storage
@inject SessionState Session
@inject LocalizationService Loc

<PageTitle>@Loc.T("Nav_Vendors") — CAMAROES POS</PageTitle>

<RoleGuard>
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert @(_err ? "alert-error" : "alert-success")" role="alert">
            <span>@_msg</span>
            <button type="button" class="btn btn-icon btn-sm" aria-label="@Loc.T("Btn_Close")" @onclick="() => _msg = string.Empty">
                <Icon Name="x" Size="16" />
            </button>
        </div>
    }

    <div class="@(_isEditing ? "grid-split" : "")">
        <div class="card stack">
            <div class="row-between">
                <input class="input" style="flex:1;min-width:200px;" aria-label="@Loc.T("Vendor_Search")" @bind="_search" @bind:event="oninput" placeholder="@Loc.T("Vendor_Search")" />
                @if (Session.IsAdmin)
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="OpenAdd">
                        <Icon Name="plus" Size="15" /><span>@Loc.T("Vendor_Add")</span>
                    </button>
                }
            </div>

            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@Loc.T("Col_Vendor")</th>
                            <th>@Loc.T("Vendor_Contact")</th>
                            <th>@Loc.T("Col_Phone")</th>
                            <th>@Loc.T("Col_Email")</th>
                            <th>@Loc.T("Vendor_Address")</th>
                            @if (Session.IsAdmin)
                            {
                                <th>@Loc.T("Col_Actions")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in FilteredVendors)
                        {
                            <tr>
                                <td><strong>@v.VendorName</strong></td>
                                <td>@v.ContactPerson</td>
                                <td>@v.Phone</td>
                                <td>@v.Email</td>
                                <td>@v.Address</td>
                                @if (Session.IsAdmin)
                                {
                                    <td class="actions-cell">
                                        <div class="row-nowrap">
                                            <button type="button" class="btn btn-outlined btn-icon" aria-label="@($"Modifier {v.VendorName}")" @onclick="() => OpenEdit(v)">
                                                <Icon Name="edit" Size="15" />
                                            </button>
                                            <button type="button" class="btn btn-danger btn-icon" aria-label="@($"Supprimer {v.VendorName}")" @onclick="() => _deleteTarget = v">
                                                <Icon Name="trash" Size="15" />
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_isEditing && _model != null && Session.IsAdmin)
        {
            <form class="card stack" @onsubmit="SaveVendorAsync" @onsubmit:preventDefault="true">
                <h2 class="card-title" style="margin:0;">@Loc.T("Vendor_Details")</h2>
                <div>
                    <label class="label-muted" for="v-name">@Loc.T("Col_Vendor")</label>
                    <input id="v-name" class="input" @bind="_model.VendorName" required />
                </div>
                <div>
                    <label class="label-muted" for="v-contact">@Loc.T("Vendor_Contact")</label>
                    <input id="v-contact" class="input" @bind="_model.ContactPerson" />
                </div>
                <div>
                    <label class="label-muted" for="v-phone">@Loc.T("Col_Phone")</label>
                    <input id="v-phone" class="input" @bind="_model.Phone" />
                </div>
                <div>
                    <label class="label-muted" for="v-email">@Loc.T("Col_Email")</label>
                    <input id="v-email" class="input" type="email" @bind="_model.Email" />
                </div>
                <div>
                    <label class="label-muted" for="v-addr">@Loc.T("Vendor_Address")</label>
                    <textarea id="v-addr" class="input" rows="2" @bind="_model.Address"></textarea>
                </div>
                <div class="grid-2">
                    <button type="button" class="btn btn-outlined" @onclick="() => _isEditing = false">@Loc.T("Btn_Cancel")</button>
                    <button type="submit" class="btn btn-primary">@Loc.T("Btn_Save")</button>
                </div>
            </form>
        }
    </div>

    <ConfirmModal IsOpen="@(_deleteTarget != null)"
                  Title="@Loc.T("Confirm_DeleteTitle")"
                  Message="@(_deleteTarget == null ? "" : $"Supprimer le fournisseur « {_deleteTarget.VendorName} » ?")"
                  ConfirmText="@Loc.T("Btn_Delete")"
                  IsDanger="true"
                  OnConfirm="ConfirmDeleteVendorAsync"
                  OnCancel="() => _deleteTarget = null" />
</RoleGuard>

@code {
    private string _search = string.Empty;
    private bool _isEditing;
    private bool _isNew;
    private Vendor? _model;
    private Vendor? _deleteTarget;
    private string _msg = string.Empty;
    private bool _err;

    private IEnumerable<Vendor> FilteredVendors => string.IsNullOrWhiteSpace(_search)
        ? Store.Vendors
        : Store.Vendors.Where(v =>
            (v.VendorName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (v.ContactPerson?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (v.Email?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override void OnInitialized()
    {
        Store.OnChanged += StateHasChanged;
        Loc.OnChange += StateHasChanged;
    }

    private void OpenAdd()
    {
        if (!Session.IsAdmin) return;
        _model = new Vendor { VendorName = "", ContactPerson = "", Phone = "", Email = "", Address = "" };
        _isNew = true; _isEditing = true;
    }

    private void OpenEdit(Vendor v)
    {
        if (!Session.IsAdmin) return;
        _model = new Vendor { Id = v.Id, VendorName = v.VendorName, ContactPerson = v.ContactPerson, Phone = v.Phone, Email = v.Email, Address = v.Address };
        _isNew = false; _isEditing = true;
    }

    private async Task SaveVendorAsync()
    {
        if (_model == null) return;
        var res = Store.SaveVendor(_model, _isNew, Session.IsAdmin);
        _msg = res.Message; _err = !res.Success;
        if (res.Success) { _isEditing = false; await Storage.PersistAsync(Store); }
    }

    private async Task ConfirmDeleteVendorAsync(string _)
    {
        if (_deleteTarget == null) return;
        var res = Store.DeleteVendor(_deleteTarget.Id, Session.IsAdmin);
        _deleteTarget = null;
        _msg = res.Message; _err = !res.Success;
        if (res.Success) await Storage.PersistAsync(Store);
    }

    public void Dispose()
    {
        Store.OnChanged -= StateHasChanged;
        Loc.OnChange -= StateHasChanged;
    }
}
