@page "/wallets"
@implements IDisposable
@inject PosStoreState Store
@inject BrowserStorageService Storage
@inject SessionState Session
@inject LocalizationService Loc

<PageTitle>@Loc.T("Nav_Wallets") — CAMAROES POS</PageTitle>

<RoleGuard>
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert @(_err ? "alert-error" : "alert-success")">
            <span>@_msg</span>
            <button class="btn btn-sm" @onclick="() => _msg = string.Empty">×</button>
        </div>
    }

    <div class="@(_isEditing ? "grid-split" : "")">
        <div class="card stack">
            <div class="row-between">
                <div class="card-title" style="margin:0;">@Loc.T("Wallet_Title")</div>
                <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ @Loc.T("Wallet_Create")</button>
            </div>

            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@Loc.T("Col_Phone")</th>
                            <th>@Loc.T("Col_Name")</th>
                            <th>@Loc.T("Col_Email")</th>
                            <th class="text-right">@Loc.T("Wallet_Balance")</th>
                            <th class="text-right">@Loc.T("Wallet_Points")</th>
                            <th class="text-right">@Loc.T("Wallet_TotalSpent")</th>
                            <th>@Loc.T("Col_Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Store.CustomerWallets)
                        {
                            <tr>
                                <td><strong>@w.Phone</strong></td>
                                <td>@w.CustomerName</td>
                                <td>@w.Email</td>
                                <td class="text-right"><strong class="text-success">@w.Balance.ToString("N0") FCFA</strong></td>
                                <td class="text-right"><span class="badge badge-info">@w.LoyaltyPoints pts</span></td>
                                <td class="text-right">@w.TotalSpent.ToString("N0")</td>
                                <td>
                                    <div class="row" style="gap:4px;">
                                        <button class="btn btn-outlined btn-sm" title="Recharger" @onclick="() => OpenRecharge(w)">💳</button>
                                        @if (Session.IsAdmin)
                                        {
                                            <button class="btn btn-danger btn-sm" title="Supprimer" @onclick="() => DeleteWalletAsync(w)">🗑</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_isEditing && _model != null)
        {
            <div class="card stack">
                <div class="card-title" style="margin:0;">@Loc.T("Wallet_Operation")</div>
                <div>
                    <label class="label-muted">@Loc.T("Col_Phone")</label>
                    <input class="input" @bind="_model.Phone" disabled="@(!_isNew)" />
                </div>
                <div>
                    <label class="label-muted">@Loc.T("Col_Name")</label>
                    <input class="input" @bind="_model.CustomerName" />
                </div>
                <div>
                    <label class="label-muted">@Loc.T("Col_Email")</label>
                    <input class="input" @bind="_model.Email" />
                </div>
                <div>
                    <label class="label-muted">@Loc.T("Wallet_Amount")</label>
                    <input class="input" type="number" min="0" @bind="_amount" />
                </div>
                <div class="grid-2">
                    <button class="btn btn-outlined" @onclick="() => _isEditing = false">@Loc.T("Btn_Cancel")</button>
                    <button class="btn btn-success" @onclick="SaveWalletAsync">@Loc.T("Btn_Confirm")</button>
                </div>
            </div>
        }
    </div>
</RoleGuard>

@code {
    private bool _isEditing;
    private bool _isNew;
    private CustomerWallet? _model;
    private double _amount;
    private string _msg = string.Empty;
    private bool _err;

    protected override void OnInitialized()
    {
        Store.OnChanged += StateHasChanged;
        Loc.OnChange += StateHasChanged;
    }

    private void OpenCreate()
    {
        _model = new CustomerWallet { Phone = "", CustomerName = "", Email = "" };
        _amount = 0; _isNew = true; _isEditing = true;
    }

    private void OpenRecharge(CustomerWallet w)
    {
        _model = new CustomerWallet { Phone = w.Phone, CustomerName = w.CustomerName, Email = w.Email, Balance = w.Balance, LoyaltyPoints = w.LoyaltyPoints, TotalSpent = w.TotalSpent };
        _amount = 0; _isNew = false; _isEditing = true;
    }

    private async Task SaveWalletAsync()
    {
        if (_model == null) return;
        var res = Store.SaveWallet(_model, _amount, _isNew);
        _msg = res.Message; _err = !res.Success;
        if (res.Success) { _isEditing = false; await Storage.PersistAsync(Store); }
    }

    private async Task DeleteWalletAsync(CustomerWallet w)
    {
        var res = Store.DeleteWallet(w.Phone, Session.IsAdmin);
        _msg = res.Message; _err = !res.Success;
        if (res.Success) await Storage.PersistAsync(Store);
    }

    public void Dispose()
    {
        Store.OnChanged -= StateHasChanged;
        Loc.OnChange -= StateHasChanged;
    }
}
